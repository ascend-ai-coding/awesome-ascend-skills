import os
import sys

import torch
import torch_npu  # Register torch.npu on supported installations.  # noqa: F401

# ═══════════════════════════════════════════════════════════════════════════════
# detailed_tensor_compare bootstrap (self-contained — no PYTHONPATH needed)
# ═══════════════════════════════════════════════════════════════════════════════
# `scripts/gen_module_test.py` copies `detailed_tensor_compare.py` into
# `custom/<op>/`, so this file resolves it from `__file__` rather than naming the
# agent framework's skills directory — that directory is a symlink whose name
# follows whichever framework the user runs, and it also left `custom/<op>/`
# unable to be copied elsewhere. `custom/<op>/`, its `modules/` and its `eval/`
# go on sys.path here so the kernel files import-resolve from any cwd. Keep the
# helper symbol names underscore-prefixed and `del` them at the end so the test
# file's public surface stays clean.
_test_dir = os.path.dirname(os.path.abspath(__file__))
_op_dir = os.path.dirname(_test_dir) if os.path.basename(_test_dir) == "modules" else _test_dir
for _p in (_test_dir, _op_dir, os.path.join(_op_dir, "eval")):
    if os.path.isdir(_p) and _p not in sys.path:
        sys.path.insert(0, _p)
if not os.path.isfile(os.path.join(_op_dir, "detailed_tensor_compare.py")):
    raise ImportError(
        "Vendored detailed_tensor_compare.py not found in " + _op_dir + ". "
        "Regenerate this test with pypto-op-verify's gen_module_test.py, which copies it."
    )
del _test_dir, _op_dir, _p
