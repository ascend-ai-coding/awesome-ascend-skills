# =============================================================================
# Helpers
# =============================================================================

def _set_device() -> None:
    """Initialise the NPU device from the standard env var."""
    torch.npu.set_device(int(os.environ.get("TILE_FWK_DEVICE_ID", "0")))
    # NZ 格式守卫: npu_format_cast(..., FRACTAL_NZ) 依赖此开关,
    # 默认关闭时静默降级为 ND, 导致声明 TILEOP_NZ 的 kernel 报 F00002。
    if hasattr(torch_npu.npu, "config") and hasattr(torch_npu.npu.config, "allow_internal_format"):
        torch_npu.npu.config.allow_internal_format = True


def _compare_all_leaves(impl_out, gold_out, *, atol: float, rtol: float, label: str) -> None:
    """Run detailed_tensor_compare on every leaf output. Multi-output
    kernels MUST iterate (NPU lesson 5: aggregating into a single
    boolean masks per-output drift)."""
    pairs = tensor_leaf_pairs(impl_out, gold_out, label)
    for output_name, actual, expected in pairs:
        result = detailed_tensor_compare(
            actual, expected,
            atol=atol, rtol=rtol,
            tensor_name=output_name,
        )
        assert result["all_close"], f"precision mismatch at {output_name}"


