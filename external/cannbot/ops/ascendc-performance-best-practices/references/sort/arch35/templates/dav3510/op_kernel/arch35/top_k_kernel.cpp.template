extern "C" int32_t calc_topk_small_axis_params(int64_t outer, int64_t axisLen, int64_t inner, int64_t isLargest,
                                                int64_t coreNum, uint64_t ubSize, TopKSmallAxisParams* params)
{
    if (params == nullptr || outer <= 0 || inner <= 1 || coreNum <= 0 ||
        (axisLen != 7 && axisLen != 17)) {
        return -1;
    }

    uint32_t tileWidth = TOPK_SMALL_AXIS_TILE;
    if (axisLen == 17) {
        uint64_t tilesPerOuter = std::max<uint64_t>(static_cast<uint64_t>(coreNum) / outer, 1U);
        uint64_t desired = std::min<uint64_t>((CeilDiv(inner, tilesPerOuter) + 15U) / 16U * 16U, 4096U);
        tileWidth = static_cast<uint32_t>(std::max<uint64_t>(desired, 16U));
        while (tileWidth >= 16U) {
            uint64_t rowBytes = AlignUp(static_cast<uint64_t>(tileWidth) * sizeof(uint16_t));
            uint64_t maskBytes = AlignUp(CeilDiv(tileWidth, 8U));
            uint64_t required = static_cast<uint64_t>(axisLen) * rowBytes * 2U + rowBytes * 2U + maskBytes * 2U;
            if (ubSize > TOPK_SIMT_RESERVED_UB && required <= ubSize - TOPK_SIMT_RESERVED_UB) {
                break;
            }
            tileWidth -= 16U;
        }
        if (tileWidth < 16U || ubSize <= TOPK_SIMT_RESERVED_UB) {
            return -3;
        }
    } else if (axisLen == 7) {
        uint64_t tilesPerOuter = std::max<uint64_t>(static_cast<uint64_t>(coreNum) / outer, 1U);
        uint64_t desired = std::min<uint64_t>(AlignUp(CeilDiv(inner, tilesPerOuter)), 4096U);
        tileWidth = static_cast<uint32_t>(std::max<uint64_t>(desired, TOPK_SMALL_AXIS_ALIGN));
        while (tileWidth >= TOPK_SMALL_AXIS_ALIGN) {
            uint64_t rowBytes = AlignUp(static_cast<uint64_t>(tileWidth) * sizeof(uint16_t));
            uint64_t maskBytes = AlignUp(CeilDiv(tileWidth, 8U));
            uint64_t required = static_cast<uint64_t>(axisLen) * rowBytes * 2U + rowBytes * 2U + maskBytes * 2U;
            if (ubSize > TOPK_SIMT_RESERVED_UB && required <= ubSize - TOPK_SIMT_RESERVED_UB) {
                break;
            }
            tileWidth -= TOPK_SMALL_AXIS_ALIGN;
        }
        if (tileWidth < TOPK_SMALL_AXIS_ALIGN || ubSize <= TOPK_SIMT_RESERVED_UB) {
            return -3;
        }
    }

    uint64_t tileCount = static_cast<uint64_t>(outer) * CeilDiv(inner, tileWidth);
    params->outer = outer;
    params->axisLen = axisLen;
    params->inner = inner;
    params->isLargest = isLargest;
    params->tileWidth = tileWidth;
    params->usedCores = static_cast<int64_t>(std::min<uint64_t>(static_cast<uint64_t>(coreNum), tileCount));
    params->localMemoryBytes = static_cast<int64_t>(ubSize - TOPK_SIMT_RESERVED_UB);
    return params->usedCores > 0 ? 0 : -4;
}

extern "C" int32_t launch_topk(GM_ADDR x, GM_ADDR y, GM_ADDR idx, GM_ADDR workspace, int64_t dtypeId,
                                const TopKLaunchParams& params, void* stream)
{
    if (params.tilingKey == TOPK_TILING_KEY_SMALL_AXIS) {
        if (dtypeId == TOPK_DTYPE_FP16) {
            return LaunchSmallAxis<half>(x, y, idx, params.smallAxis, stream);
        }
        if (dtypeId == TOPK_DTYPE_BF16) {
            return LaunchSmallAxis<bfloat16_t>(x, y, idx, params.smallAxis, stream);
        }
        return static_cast<int32_t>(ACL_ERROR_INVALID_PARAM);
    }
    if (params.tilingKey == TOPK_TILING_KEY_TRANSPOSE_FALLBACK) {
        return LaunchTransposeFallback(x, y, idx, workspace, dtypeId, params, stream);
    }
    if (params.tilingKey == TOPK_TILING_KEY_FALLBACK) {
        launch_topk_fallback(x, y, idx, dtypeId, params.fallback, stream);
        return 0;
    }
    if (params.tilingKey == 23003 || params.tilingKey == 33003) {
        return LaunchTopKKernel(&topk_fp32_merge_direct_kernel, x, y, idx, workspace, params, stream);
    }
    if (params.tilingKey == 13002) {
        return LaunchTopKKernel(&topk_small_merge_direct_kernel<half, half>, x, y, idx, workspace, params,
                                  stream);
    }
    if (params.tilingKey == 13003) {
        return LaunchTopKKernel(&topk_small_merge_direct_kernel<float, float>, x, y, idx, workspace, params,
                                  stream);
    }
    if (params.tilingKey == 14002) {
        return LaunchTopKKernel(&topk_small_merge_direct_kernel<bfloat16_t, float>, x, y, idx, workspace,
                                  params, stream);
    }
    switch (dtypeId) {
        case TOPK_DTYPE_INT8:
            return LaunchTopKKernel(&topk_common_direct_kernel<int8_t, uint8_t, 1>, x, y, idx, workspace,
                                      params, stream);
        case TOPK_DTYPE_UINT8:
            return LaunchTopKKernel(&topk_common_direct_kernel<uint8_t, uint8_t, 1>, x, y, idx, workspace,
                                      params, stream);
        case TOPK_DTYPE_INT32:
            return LaunchTopKKernel(&topk_common_direct_kernel<int32_t, uint32_t, 4>, x, y, idx, workspace,
                                      params, stream);
        case TOPK_DTYPE_FP16:
            return LaunchTopKKernel(&topk_common_direct_kernel<half, uint16_t, 2>, x, y, idx, workspace,
                                      params, stream);
        case TOPK_DTYPE_FP32:
            return LaunchTopKKernel(&topk_common_direct_kernel<float, uint32_t, 4>, x, y, idx, workspace,
                                      params, stream);
        case TOPK_DTYPE_BF16:
            return LaunchTopKKernel(&topk_common_direct_kernel<bfloat16_t, uint16_t, 2>, x, y, idx, workspace,
                                      params, stream);
        default: return static_cast<int32_t>(ACL_ERROR_INVALID_PARAM);
    }
}
