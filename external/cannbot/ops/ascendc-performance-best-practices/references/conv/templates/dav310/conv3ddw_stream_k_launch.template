/* Materialize as conv3ddw_stream_k_launch.h; host-only, no device/registry dependency. */
#ifndef CONV3DDW_STREAM_K_LAUNCH_H
#define CONV3DDW_STREAM_K_LAUNCH_H
#include <cstdint>
#include "conv3ddw_stream_k_tiling.h"
// X/dY: contiguous NCDHW, matching input dtype. dW: FP32 [Co,Ci,Kd,Kh,Kw].
