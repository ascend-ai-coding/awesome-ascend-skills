        // loop3_dst_stride, nd_dst_stride
        fixPipeParams.params.dstNdStride = self->ctx.cinG_;
        // 当dk>1且分核时，nSize必须为真实值，原因是多写的部分会跟下一个核出现同地址，不同核atomicAdd，导致精度错误
        if (tailCinExist && (self->ctx.cinRemainLen_ < baseCin)) {
