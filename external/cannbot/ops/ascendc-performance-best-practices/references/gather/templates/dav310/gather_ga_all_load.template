/*!
 * \file gather_ga_all_load.h
 * \brief GA 全载 Gather 参考模板（Reg API Gather / VF，dav-3510 / Ascend950）。
 *
 * 参考 ops-nn gather_v2_ga_all_load.h 模式：将 x 的 GA block（gatherDimSize × innerSize）
 * 全载入 UB，索引预计算字节偏移后用 Reg::Gather 一条指令向量化 gather。
 * 2D 多核切分 [pOuter(outer split), indicesOuter(gather split)]，y 双 buffer 流水。
 *
 * 适用：innerSize 适中（>32 且 <2048），gatherDimSize × innerSize 可全载 UB，
 *      batchSize==1 且索引重复访问 x 行（gatherSize/gatherDimSize > 1）。
 *
 * enableGather_ flag: xBufGaNum × aSizeAligned ≤ 512 时启用 Gather 快路径，
 * 否则降级到 GatherProcessVfWithGA 标量逐索引 VF gather。
 */

#ifndef GATHER_GA_ALL_LOAD_H
#define GATHER_GA_ALL_LOAD_H

#ifndef K_MAX_SHAPE_DIM
#define K_MAX_SHAPE_DIM 0
#endif

#include "kernel_tiling/kernel_tiling.h"
#include "kernel_operator.h"
#include "op_kernel/platform_util.h"
#include "gather_tiling_data.h"

namespace gatherv2 {
using namespace AscendC;

constexpr int32_t DOUBLE_BUFFER = 2;
constexpr int32_t HELP_BUFFER_SIZE = 256;
constexpr int32_t GATHER_ENABLE_SIZE = 512;

template <typename INDICES_T, const bool NIS>
class GatherGaAllLoad {
public:
    __aicore__ inline GatherGaAllLoad(TPipe* pipe) : pipe_(pipe){};
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR indices, GM_ADDR y,
                                const GatherGaAllLoadTilingData* tilingData);
    __aicore__ inline void GenIndexBuf();
    __aicore__ inline void Process();
    __aicore__ inline void IndicesProcess(int32_t indicesNumPro, int32_t indicesNumOffset);
    __aicore__ inline void xProcess(int32_t gaCoreOffset, int32_t gaNumPro);
    __aicore__ inline void yProcess(int32_t indicesNumPro, int32_t indicesNumOffset, int32_t gaNumPro,
                                    int32_t gaCoreOffset);
    __aicore__ inline void GatherProcess(int32_t indicesUbOffset, int32_t indicesNumCurPro,
                                         __ubuf__ int32_t* indicesAddr, __ubuf__ int8_t* xAddr,
                                         __ubuf__ int8_t* yAddr);
    __aicore__ inline void FixIndices(__ubuf__ INDICES_T* indicesAddr, int32_t indicesNumPro);
    __aicore__ inline void CopyInIndices(LocalTensor<INDICES_T>& indicesLocal, int32_t burstLen, int32_t coreOffset);
    __aicore__ inline void CopyInX(LocalTensor<int8_t>& xLocal, int32_t gaCoreOffset, int32_t gaNumPro);
    __aicore__ inline void CopyOutY(int32_t nBurst, int32_t indicesCoreOffset, int32_t pCoreOffset, int32_t gaNumPro);
    __aicore__ inline void GatherProcessVfWithGA(int32_t indicesNumCurPro, uint16_t gaNumPro,
                                                 __ubuf__ int32_t* curIndicesAddr, __ubuf__ int8_t* xAddr,
                                                 __ubuf__ int8_t* yAddr);
    __aicore__ inline void GatherProcessWithGA2(int32_t indicesNumCurPro, uint16_t gaNumPro,
                                                __ubuf__ int32_t* curIndicesAddr, __ubuf__ int8_t* xAddr,
                                                __ubuf__ int8_t* yAddr);
    __aicore__ inline void InitializationX(int32_t xBufGaNum);

private:
    // Dtype-improve: xGm_ 使用 int8_t 做 bit-copy
    GlobalTensor<int8_t> xGm_;
    GlobalTensor<INDICES_T> indicesGm_;
    GlobalTensor<int8_t> yGm_;
    TPipe* pipe_;
    // x GA block 全载 UB (xBuf_)，index tile (indicesBuf_)，y 双 buffer (yQueue_)
    TBuf<QuePosition::VECCALC> xBuf_;
    TBuf<QuePosition::VECCALC> indicesBuf_;
    TBuf<QuePosition::VECCALC> tmpIndexBuf_;
    TQue<QuePosition::VECOUT, DOUBLE_BUFFER> yQueue_;
    const GatherGaAllLoadTilingData* tilingData_;

    int32_t blockIdx_;
    // enableGather_: true 时走 Gather 快路径，false 时走 VF 标量逐索引 gather
    bool enableGather_;

    int64_t curCoreIndicesNum_;
    int64_t curCoreGaNum_;

    int64_t xGmOffset_;
    int64_t indicesGmOffset_;
};

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::Init(GM_ADDR x, GM_ADDR indices, GM_ADDR y,
                                                             const GatherGaAllLoadTilingData* tilingData)
{
    tilingData_ = tilingData;
    blockIdx_ = GetBlockIdx();

    // 先分核再分 UB: 2D 多核 [pOuter(outer split), indicesOuter(gather split)]
    int64_t pIndex = blockIdx_ / tilingData_->indicesOuter;
    int64_t indicesIndex = blockIdx_ % tilingData_->indicesOuter;

    indicesGmOffset_ = indicesIndex * tilingData_->normalCoreIndicesNum;
    xGmOffset_ = pIndex * tilingData_->normalCoreGaNum;

    curCoreIndicesNum_ = (indicesIndex + 1 == tilingData_->indicesOuter) ? tilingData_->tailCoreIndicesNum :
                                                                           tilingData_->normalCoreIndicesNum;
    curCoreGaNum_ = (pIndex + 1 == tilingData_->pOuter) ? tilingData_->tailCoreGaNum : tilingData_->normalCoreGaNum;

    if (blockIdx_ >= tilingData_->usedCoreNum) {
        return;
    }

    xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
    indicesGm_.SetGlobalBuffer((__gm__ INDICES_T*)indices);
    yGm_.SetGlobalBuffer((__gm__ int8_t*)y);

    pipe_->InitBuffer(xBuf_, tilingData_->xBufferSize);
    pipe_->InitBuffer(indicesBuf_, tilingData_->indicesBufferSize);
    pipe_->InitBuffer(tmpIndexBuf_, HELP_BUFFER_SIZE);
    pipe_->InitBuffer(yQueue_, DOUBLE_BUFFER, tilingData_->yBufferSize);
}

// ============================================================================
// GenIndexBufVF: 生成列偏移 buffer（0,1,2,...,colFactor-1,0,1,...）via Arange/Div/Mul/Sub。
//   用于 GatherProcessWithGA2 中按列偏移递增索引地址。
// ============================================================================
__simd_vf__ inline void GenIndexBufVF(__ubuf__ int32_t* helpAddr, int32_t colFactor)
{
    AscendC::Reg::RegTensor<int32_t> v0;
    AscendC::Reg::RegTensor<int32_t> v1;
    AscendC::Reg::RegTensor<int32_t> vd1;
    AscendC::Reg::RegTensor<int32_t> vd2;
    AscendC::Reg::RegTensor<int32_t> vd3;

    AscendC::Reg::MaskReg preg = AscendC::Reg::CreateMask<int32_t, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::Duplicate(v1, colFactor, preg);
    AscendC::Reg::Arange(v0, 0);
    AscendC::Reg::Div(vd1, v0, v1, preg);
    AscendC::Reg::Mul(vd2, vd1, v1, preg);
    AscendC::Reg::Sub(vd3, v0, vd2, preg);
    AscendC::Reg::StoreAlign(helpAddr, vd3, preg);
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::GenIndexBuf()
{
    LocalTensor<int32_t> helpTensor = tmpIndexBuf_.Get<int32_t>();
    __ubuf__ int32_t* helpAddr = (__ubuf__ int32_t*)helpTensor.GetPhyAddr();
    int32_t colFactor = Ops::Base::GetUbBlockSize() / sizeof(int32_t);
    int32_t colAlign = tilingData_->aSizeAligned / sizeof(int32_t);

    GenIndexBufVF(helpAddr, colFactor);
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::IndicesProcess(int32_t indicesNumPro,
                                                                       int32_t indicesNumOffset)
{
    event_t eventIdMTE3toMTE2 = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_MTE2));
    SetFlag<HardEvent::MTE3_MTE2>(eventIdMTE3toMTE2);

    WaitFlag<HardEvent::MTE3_MTE2>(eventIdMTE3toMTE2);
    LocalTensor<INDICES_T> indicesTensor = indicesBuf_.Get<INDICES_T>();
    CopyInIndices(indicesTensor, indicesNumPro, indicesNumOffset);
    event_t eventIdMTE2toV = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
    SetFlag<HardEvent::MTE2_V>(eventIdMTE2toV);

    WaitFlag<HardEvent::MTE2_V>(eventIdMTE2toV);
    __ubuf__ INDICES_T* indicesAddr = (__ubuf__ INDICES_T*)indicesTensor.GetPhyAddr();
    FixIndices(indicesAddr, indicesNumPro);
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::xProcess(int32_t gaCoreOffset, int32_t gaNumPro)
{
    event_t eventIdMTE3toMTE2 = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_MTE2));
    SetFlag<HardEvent::MTE3_MTE2>(eventIdMTE3toMTE2);

    WaitFlag<HardEvent::MTE3_MTE2>(eventIdMTE3toMTE2);
    LocalTensor<int8_t> xLocal = xBuf_.Get<int8_t>();
    CopyInX(xLocal, gaCoreOffset, gaNumPro);
}

// ============================================================================
// InitializationXVF: 零填充 x buffer（含 padding 区域）via VF Duplicate + DataCopy。
//   每个 GA block 的 aSizeAligned 区域全填 0，后续 CopyInX 只覆盖有效数据，padding 保持 0。
// ============================================================================
__simd_vf__ inline void InitializationXVF(__ubuf__ int8_t* xAddr, uint32_t aSizeAligned, uint32_t gaOffset,
                                          uint16_t computeSize, uint16_t repeatimes, int32_t xBufGaNum)
{
    AscendC::Reg::RegTensor<int8_t> zeroConstReg;
    AscendC::Reg::Duplicate(zeroConstReg, int8_t(0));
    Reg::MaskReg preg;
    for (uint16_t g = 0; g < static_cast<uint16_t>(xBufGaNum); g++) {
        uint32_t sreg = aSizeAligned;
        for (uint16_t r = 0; r < repeatimes; r++) {
            preg = Reg::UpdateMask<int8_t>(sreg);
            Reg::AddrReg offset = Reg::CreateAddrReg<int8_t>(r, computeSize);
            Reg::StoreAlign(xAddr, zeroConstReg, offset, preg);
        }
        xAddr += gaOffset;
    }
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::InitializationX(int32_t xBufGaNum)
{
    LocalTensor<int8_t> xLocal = xBuf_.Get<int8_t>();
    __ubuf__ int8_t* xAddr = (__ubuf__ int8_t*)xLocal.GetPhyAddr();
    uint32_t aSizeAligned = tilingData_->aSizeAligned;
    uint32_t gaOffset = (tilingData_->gSize + 1) * aSizeAligned;
    uint16_t computeSize = Ops::Base::GetVRegSize();
    uint16_t repeatimes = (aSizeAligned + computeSize - 1) / computeSize;

    InitializationXVF(xAddr, aSizeAligned, gaOffset, computeSize, repeatimes, xBufGaNum);
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::yProcess(int32_t indicesNumPro, int32_t indicesNumOffset,
                                                                 int32_t gaNumPro, int32_t gaCoreOffset)
{
    event_t eventIdMTE2toV = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
    SetFlag<HardEvent::MTE2_V>(eventIdMTE2toV);

    WaitFlag<HardEvent::MTE2_V>(eventIdMTE2toV);
    LocalTensor<INDICES_T> indicesTensor = indicesBuf_.Get<INDICES_T>();
    __ubuf__ INDICES_T* indicesAddr = (__ubuf__ INDICES_T*)indicesTensor.GetPhyAddr();
    LocalTensor<int8_t> xTensor = xBuf_.Get<int8_t>();
    __ubuf__ int8_t* xAddr = (__ubuf__ int8_t*)xTensor.GetPhyAddr();

    int32_t indicesNumToDealWithGa = tilingData_->yBufferSize / (tilingData_->aSizeAligned * gaNumPro);
    if (enableGather_) {
        uint16_t vRegBlockNum = Ops::Base::GetVRegSize() / Ops::Base::GetUbBlockSize();
        indicesNumToDealWithGa = indicesNumToDealWithGa / vRegBlockNum * vRegBlockNum;
    }

    if (indicesNumToDealWithGa != 0) {
        int32_t yloopCountWithGa = (indicesNumPro + indicesNumToDealWithGa - 1) / indicesNumToDealWithGa;

        for (int32_t y = 0; y < yloopCountWithGa; y++) {
            LocalTensor<int8_t> yLocal = yQueue_.AllocTensor<int8_t>();
            __ubuf__ int8_t* yAddr = (__ubuf__ int8_t*)yLocal.GetPhyAddr();
            int32_t indicesNumCurPro = y == (yloopCountWithGa - 1) ?
                                           indicesNumPro - (yloopCountWithGa - 1) * indicesNumToDealWithGa :
                                           indicesNumToDealWithGa;
            int32_t indicesUbOffset = y * indicesNumToDealWithGa;
            __ubuf__ int32_t* curIndicesAddr = (__ubuf__ int32_t*)indicesAddr + indicesUbOffset;
            if (enableGather_) {
                GatherProcessWithGA2(indicesNumCurPro, gaNumPro, (__ubuf__ int32_t*)curIndicesAddr, xAddr, yAddr);
            } else {
                GatherProcessVfWithGA(indicesNumCurPro, gaNumPro, (__ubuf__ int32_t*)curIndicesAddr, xAddr, yAddr);
            }
            yQueue_.EnQue<int8_t>(yLocal);
            CopyOutY(indicesNumCurPro, indicesNumOffset + y * indicesNumToDealWithGa, gaCoreOffset, gaNumPro);
        }
    } else {
        int32_t yBufANum = tilingData_->yBufferSize / tilingData_->aSizeAligned;
        int32_t yloopCount = (indicesNumPro + yBufANum - 1) / yBufANum;

        for (int32_t gaIndex = 0; gaIndex < gaNumPro; gaIndex++) {
            for (int32_t y = 0; y < yloopCount; y++) {
                LocalTensor<int8_t> yLocal = yQueue_.AllocTensor<int8_t>();
                __ubuf__ int8_t* yAddr = (__ubuf__ int8_t*)yLocal.GetPhyAddr();
                int32_t indicesNumCurPro = y == (yloopCount - 1) ? indicesNumPro - (yloopCount - 1) * yBufANum :
                                                                   yBufANum;
                int32_t indicesUbOffset = y * yBufANum;
                __ubuf__ int8_t* xAddrWithOffset = xAddr +
                                                        gaIndex * (tilingData_->gSize + 1) * tilingData_->aSizeAligned;
                GatherProcess(indicesUbOffset, indicesNumCurPro, (__ubuf__ int32_t*)indicesAddr, xAddrWithOffset,
                              yAddr);
                yQueue_.EnQue<int8_t>(yLocal);
                CopyOutY(indicesNumCurPro, indicesNumOffset + y * yBufANum, gaCoreOffset + gaIndex, 1);
            }
        }
    }
}

// ============================================================================
// GatherProcessVF: 标量逐索引 VF gather（enableGather_=false 时的 fallback）。
//   每个索引从 xAddr 读取 aSize 字节到 vregTemp，再写到 yAddr 对应位置。
//   repeatimes > 1 时分多次 repeat 处理 aSize > VRegSize 的情况。
// ============================================================================
__simd_vf__ inline void GatherProcessVF(__ubuf__ int8_t* xAddr, __ubuf__ int8_t* curYAddr,
                                        __ubuf__ int32_t* curIndicesAddr, int32_t indicesNumCurPro,
                                        uint16_t computeSize, uint16_t repeatimes, uint32_t aSize,
                                        uint32_t aSizeAligned)
{
    Reg::RegTensor<int8_t> vregTemp;
    Reg::MaskReg preg;

    for (uint16_t indices = 0; indices < static_cast<uint16_t>(indicesNumCurPro); indices++) {
        uint32_t indicesValue = (curIndicesAddr[indices]);
        uint32_t sreg = aSize;
        __ubuf__ int8_t* curXAddr = xAddr + indicesValue;
        for (uint16_t r = 0; r < repeatimes; r++) {
            preg = Reg::UpdateMask<int8_t>(sreg);
            Reg::AddrReg offset = Reg::CreateAddrReg<int8_t>(r, computeSize);
            Reg::LoadAlign(vregTemp, curXAddr, offset);
            Reg::StoreAlign(curYAddr, vregTemp, offset, preg);
        }
        curYAddr += aSizeAligned;
    }
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::GatherProcess(int32_t indicesUbOffset,
                                                                      int32_t indicesNumCurPro,
                                                                      __ubuf__ int32_t* indicesAddr,
                                                                      __ubuf__ int8_t* xAddr,
                                                                      __ubuf__ int8_t* yAddr)
{
    uint16_t computeSize = Ops::Base::GetVRegSize();
    uint16_t repeatimes = (tilingData_->aSize + computeSize - 1) / computeSize;
    uint32_t aSize = tilingData_->aSize;
    uint32_t aSizeAligned = tilingData_->aSizeAligned;
    __ubuf__ int8_t* curYAddr = yAddr;
    __ubuf__ int32_t* curIndicesAddr = indicesAddr + indicesUbOffset;
    GatherProcessVF(xAddr, curYAddr, curIndicesAddr, indicesNumCurPro, computeSize, repeatimes, aSize, aSizeAligned);
}

// ============================================================================
// RepeatOneVF: aSize ≤ VRegSize（repeatimes==1）时的快路径，单次 DataCopy 完成 gather。
// ============================================================================
__simd_vf__ inline void RepeatOneVF(__ubuf__ int32_t* curIndicesAddr, __ubuf__ int8_t* xAddr, __ubuf__ int8_t* yAddr,
                                    int32_t indicesNumCurPro, uint16_t gaNumPro, uint32_t aSize, uint32_t aSizeAligned,
                                    uint32_t gaOffset, uint32_t yOffset)
{
    Reg::RegTensor<int8_t> vregTemp;
    Reg::MaskReg preg;

    for (uint16_t indices = 0; indices < static_cast<uint16_t>(indicesNumCurPro); indices++) {
        uint32_t indicesValue = (curIndicesAddr[indices]);
        __ubuf__ int8_t* curYAddr = yAddr;
        __ubuf__ int8_t* curXAddr = xAddr + indicesValue;
        for (uint16_t ga = 0; ga < gaNumPro; ga++) {
            uint32_t sreg = aSize;
            preg = Reg::UpdateMask<int8_t>(sreg);
            Reg::LoadAlign(vregTemp, curXAddr);
            Reg::StoreAlign(curYAddr, vregTemp, preg);
            curXAddr += gaOffset;
            curYAddr += yOffset;
        }
        yAddr += aSizeAligned;
    }
}

// ============================================================================
// RepeatOtherVF: aSize > VRegSize（repeatimes>1）时的通用路径，分多次 repeat gather。
// ============================================================================
__simd_vf__ inline void RepeatOtherVF(__ubuf__ int32_t* curIndicesAddr, __ubuf__ int8_t* xAddr, __ubuf__ int8_t* yAddr,
                                      int32_t indicesNumCurPro, uint16_t gaNumPro, uint32_t aSize,
                                      uint32_t aSizeAligned, uint32_t gaOffset, uint32_t yOffset, uint16_t repeatimes,
                                      uint16_t computeSize)
{
    Reg::RegTensor<int8_t> vregTemp;
    Reg::MaskReg preg;

    for (uint16_t indices = 0; indices < static_cast<uint16_t>(indicesNumCurPro); indices++) {
        uint32_t indicesValue = (curIndicesAddr[indices]);
        __ubuf__ int8_t* curYAddr = yAddr;
        __ubuf__ int8_t* curXAddr = xAddr + indicesValue;
        for (uint16_t ga = 0; ga < gaNumPro; ga++) {
            uint32_t sreg = aSize;
            for (uint16_t r = 0; r < repeatimes; r++) {
                preg = Reg::UpdateMask<int8_t>(sreg);
                Reg::AddrReg offset = Reg::CreateAddrReg<int8_t>(r, computeSize);
                Reg::LoadAlign(vregTemp, curXAddr, offset);
                Reg::StoreAlign(curYAddr, vregTemp, offset, preg);
            }
            curXAddr += gaOffset;
            curYAddr += yOffset;
        }
        yAddr += aSizeAligned;
    }
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::GatherProcessVfWithGA(int32_t indicesNumCurPro,
                                                                              uint16_t gaNumPro,
                                                                              __ubuf__ int32_t* curIndicesAddr,
                                                                              __ubuf__ int8_t* xAddr,
                                                                              __ubuf__ int8_t* yAddr)
{
    uint16_t computeSize = Ops::Base::GetVRegSize();
    uint16_t repeatimes = (tilingData_->aSize + computeSize - 1) / computeSize;
    uint32_t aSize = tilingData_->aSize;
    uint32_t aSizeAligned = tilingData_->aSizeAligned;
    uint32_t gaOffset = (tilingData_->gSize + 1) * aSizeAligned;
    uint32_t yOffset = indicesNumCurPro * aSizeAligned;

    if (repeatimes == 1) {
        RepeatOneVF(curIndicesAddr, xAddr, yAddr, indicesNumCurPro, gaNumPro, aSize, aSizeAligned, gaOffset, yOffset);
    } else {
        RepeatOtherVF(curIndicesAddr, xAddr, yAddr, indicesNumCurPro, gaNumPro, aSize, aSizeAligned, gaOffset, yOffset,
                      repeatimes, computeSize);
    }
}

// ============================================================================
// GatherProcessWithGA2VF: Gather 快路径（enableGather_=true）。
//   使用 Reg::Gather 按预计算字节偏移 indicesReg 从 xAddr gather 一个 VL 的元素。
//   helpAddr 存储列偏移（0..vRegBlockNum-1 循环），Add(indicesReg, curUpIndex) 累加行偏移。
//   按 aAlignedLoopNum（aSizeAligned/ubBlockSize 个列块）× indicesLoopNum（索引分批）× pLoopNum（GA block）三层循环。
// ============================================================================
__simd_vf__ inline void GatherProcessWithGA2VF(__ubuf__ int32_t* curIndicesAddr, __ubuf__ int8_t* xAddr,
                                               __ubuf__ int8_t* yAddr, __ubuf__ uint32_t* helpAddr, uint32_t gaOffset,
                                               uint32_t yOffset, uint16_t vRegBlockNum, uint16_t indicesLoopNum,
                                               uint16_t aAlignedLoopNum, uint16_t aNumPerLoop, uint16_t pLoopNum,
                                               uint32_t blockStride, int32_t yInnerOffset, uint32_t tailANum)
{
    Reg::RegTensor<uint32_t> indicesReg;
    Reg::RegTensor<uint32_t> upIndex;
    Reg::RegTensor<uint32_t> curUpIndex;

    Reg::RegTensor<int32_t> vd0;

    Reg::MaskReg preg = Reg::CreateMask<int32_t, Reg::MaskPattern::ALL>();
    Reg::MaskReg pTail = Reg::UpdateMask<int32_t>(tailANum);

    __ubuf__ int32_t* curXAddr = (__ubuf__ int32_t*)xAddr;
    __ubuf__ int32_t* pYAddr = (__ubuf__ int32_t*)yAddr;
    Reg::LoadAlign<uint32_t>(upIndex, helpAddr);
    for (uint16_t ga = 0; ga < pLoopNum; ga++) {
        Reg::Move(curUpIndex, upIndex, preg);
        __ubuf__ int32_t* aYAddr = pYAddr;
        for (uint16_t r = 0; r < aAlignedLoopNum; r++) {
            __ubuf__ uint32_t* indicesAddr = (__ubuf__ uint32_t*)curIndicesAddr;
            __ubuf__ int32_t* curYAddr = aYAddr;
            for (uint16_t indices = 0; indices < indicesLoopNum; indices++) {
                Reg::LoadAlign<uint32_t, Reg::LoadDist::DIST_E2B_B32>(indicesReg, indicesAddr);

                Reg::Add(indicesReg, indicesReg, curUpIndex, preg);
                Reg::Gather(vd0, curXAddr, indicesReg, preg);
                Reg::StoreAlign<int32_t, Reg::DataCopyMode::DATA_BLOCK_COPY>(curYAddr, vd0, blockStride, preg);
                indicesAddr += vRegBlockNum;
                curYAddr += yInnerOffset;
            }
            Reg::LoadAlign<uint32_t, Reg::LoadDist::DIST_E2B_B32>(indicesReg, indicesAddr);
            Reg::Add(indicesReg, indicesReg, curUpIndex, pTail);
            Reg::Gather(vd0, curXAddr, indicesReg, pTail);
            Reg::StoreAlign<int32_t, Reg::DataCopyMode::DATA_BLOCK_COPY>(curYAddr, vd0, blockStride, pTail);
            Reg::Adds(curUpIndex, curUpIndex, aNumPerLoop, preg);
            aYAddr += aNumPerLoop;
        }
        curXAddr += gaOffset;
        pYAddr += yOffset;
    }
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::GatherProcessWithGA2(int32_t indicesNumCurPro,
                                                                             uint16_t gaNumPro,
                                                                             __ubuf__ int32_t* curIndicesAddr,
                                                                             __ubuf__ int8_t* xAddr,
                                                                             __ubuf__ int8_t* yAddr)
{
    constexpr uint16_t b32DtypeSize = 4;
    uint32_t ubBlockSize = Ops::Base::GetUbBlockSize();
    uint32_t aSizeAligned = tilingData_->aSizeAligned;
    uint32_t gaOffset = (tilingData_->gSize + 1) * aSizeAligned / b32DtypeSize;
    uint32_t yOffset = indicesNumCurPro * aSizeAligned / b32DtypeSize;

    uint16_t vRegBlockNum = Ops::Base::GetVRegSize() / ubBlockSize; // 单次加载8个索引
    uint16_t indicesLoopNum = (indicesNumCurPro + vRegBlockNum - 1) / vRegBlockNum;
    uint16_t tailIndices = indicesNumCurPro - (indicesLoopNum - 1) * vRegBlockNum;
    indicesLoopNum -= 1;
    uint16_t aAlignedLoopNum = aSizeAligned / ubBlockSize;
    uint16_t aNumPerLoop = ubBlockSize / b32DtypeSize;
    uint16_t pLoopNum = gaNumPro;

    LocalTensor<uint32_t> helpTensor = tmpIndexBuf_.Get<uint32_t>();
    __ubuf__ uint32_t* helpAddr = (__ubuf__ uint32_t*)helpTensor.GetPhyAddr();

    uint32_t blockStride = aSizeAligned / ubBlockSize;
    int32_t yInnerOffset = vRegBlockNum * aSizeAligned / b32DtypeSize;
    uint32_t tailANum = tailIndices * aNumPerLoop;

    GatherProcessWithGA2VF(curIndicesAddr, xAddr, yAddr, helpAddr, gaOffset, yOffset, vRegBlockNum, indicesLoopNum,
                           aAlignedLoopNum, aNumPerLoop, pLoopNum, blockStride, yInnerOffset, tailANum);
}

// ============================================================================
// FixIndicesVF: 索引预处理 — 负索引补偿 + 越界 clamp + 预计算字节偏移。
//   1. 负索引补偿（NIS=true）：idx<0 → idx+=gatherDimSize
//   2. 越界 clamp：idx<0 或 idx>=gatherDimSize → -1（指向 x buffer 零填充区域）
//   3. 预计算字节偏移：Adds(1) + Muls(aSizeAligned)，后续 Gather 直接用偏移寻址
//   int64 索引使用 RegTraitNumTwo 模式加载，完整校验后取低 32 位参与运算。
// ============================================================================
template <typename INDICES_T, const bool NIS>
__simd_vf__ inline void FixIndicesVF(__ubuf__ INDICES_T* indicesAddr, int32_t indicesNumPro, int32_t aSizeAligned,
                                     int32_t gatherDimSize, uint16_t computeSizeT, uint16_t repeatimes)
{
    AscendC::Reg::RegTensor<int32_t> zeroConstReg;
    AscendC::Reg::Duplicate(zeroConstReg, int32_t(0));

    AscendC::Reg::RegTensor<int32_t> limitConstReg;
    AscendC::Reg::Duplicate(limitConstReg, int32_t(gatherDimSize));

    AscendC::Reg::RegTensor<int32_t> indicesReg;
    AscendC::Reg::RegTensor<int32_t> tmpReg;

    uint32_t indicesMask = indicesNumPro;
    AscendC::Reg::MaskReg fixMask;
    for (uint16_t i = 0; i < repeatimes; i++) {
        AscendC::Reg::MaskReg preg = AscendC::Reg::UpdateMask<int32_t>(indicesMask);
        if constexpr (std::is_same<INDICES_T, int32_t>::value) {
            AscendC::Reg::LoadAlign(indicesReg, indicesAddr + i * computeSizeT);
        } else {
            AscendC::Reg::RegTensor<int64_t, AscendC::Reg::RegTraitNumTwo> indicesRegTwo;
            AscendC::Reg::LoadAlign(indicesRegTwo, indicesAddr + i * computeSizeT);
            // RegTraitNumTwo uses B32 predicates. Validate the complete I64
            // before narrowing so out-of-range high bits cannot alias a valid row.
            AscendC::Reg::MaskReg invalidLow, invalidHigh;
            AscendC::Reg::Compares<int64_t, CMPMODE::LT>(
                invalidLow, indicesRegTwo, int64_t(NIS ? -gatherDimSize : 0), preg);
            AscendC::Reg::Compares<int64_t, CMPMODE::GE>(
                invalidHigh, indicesRegTwo, int64_t(gatherDimSize), preg);
            AscendC::Reg::Duplicate<int64_t, AscendC::Reg::MaskMergeMode::MERGING>(
                indicesRegTwo, int64_t(gatherDimSize), invalidLow);
            AscendC::Reg::Duplicate<int64_t, AscendC::Reg::MaskMergeMode::MERGING>(
                indicesRegTwo, int64_t(gatherDimSize), invalidHigh);
            indicesReg = (AscendC::Reg::RegTensor<int32_t>&)indicesRegTwo.reg[0];
        }

        if constexpr (NIS) {
            AscendC::Reg::Compare<int32_t, CMPMODE::LT>(fixMask, indicesReg, zeroConstReg, preg);
            AscendC::Reg::Adds(tmpReg, indicesReg, gatherDimSize, fixMask); // 补偿负索引场景
            AscendC::Reg::Move<int32_t, AscendC::Reg::MaskMergeMode::MERGING>(indicesReg, tmpReg, fixMask);
        }

        AscendC::Reg::Compare<int32_t, CMPMODE::LT>(fixMask, indicesReg, zeroConstReg, preg);
        AscendC::Reg::Duplicate(tmpReg, int32_t(-1), fixMask); // 补偿负越界场景
        AscendC::Reg::Move<int32_t, AscendC::Reg::MaskMergeMode::MERGING>(indicesReg, tmpReg, fixMask);

        AscendC::Reg::Compare<int32_t, CMPMODE::GE>(fixMask, indicesReg, limitConstReg, preg);
        AscendC::Reg::Duplicate(tmpReg, int32_t(-1), fixMask); // 补偿正越界场景
        AscendC::Reg::Move<int32_t, AscendC::Reg::MaskMergeMode::MERGING>(indicesReg, tmpReg, fixMask);

        AscendC::Reg::Adds(indicesReg, indicesReg, 1, preg);
        AscendC::Reg::Muls(indicesReg, indicesReg, aSizeAligned, preg);
        AscendC::Reg::StoreAlign((__ubuf__ int32_t*)indicesAddr + i * computeSizeT, indicesReg, preg);
    }
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::FixIndices(__ubuf__ INDICES_T* indicesAddr,
                                                                   int32_t indicesNumPro)
{
    int32_t aSizeAligned = tilingData_->aSizeAligned;
    if (enableGather_) {
        constexpr uint16_t b32DtypeSize = 4;
        aSizeAligned = aSizeAligned / b32DtypeSize;
    }

    int32_t gatherDimSize = tilingData_->gSize;
    uint16_t computeSizeT = Ops::Base::GetVRegSize() / sizeof(int32_t);
    uint16_t repeatimes = (indicesNumPro + computeSizeT - 1) / computeSizeT;
    FixIndicesVF<INDICES_T, NIS>(indicesAddr, indicesNumPro, aSizeAligned, gatherDimSize, computeSizeT, repeatimes);
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::CopyInIndices(LocalTensor<INDICES_T>& indicesLocal,
                                                                      int32_t burstLen, int32_t coreOffset)
{
    DataCopyPadExtParams<INDICES_T> dataCopyPadExtParams;
    dataCopyPadExtParams.isPad = false;
    dataCopyPadExtParams.leftPadding = 0;
    dataCopyPadExtParams.rightPadding = 0;
    dataCopyPadExtParams.paddingValue = 0;

    DataCopyExtParams dataCoptExtParams;
    dataCoptExtParams.blockCount = 1;
    dataCoptExtParams.blockLen = burstLen * sizeof(INDICES_T);
    dataCoptExtParams.srcStride = 0;
    dataCoptExtParams.dstStride = 0;
    DataCopyPad(indicesLocal, indicesGm_[indicesGmOffset_ + coreOffset], dataCoptExtParams, dataCopyPadExtParams);
}

// ============================================================================
// CopyInX: SetLoopModePara 实现 strided multi-row DMA。
//   loop1 = gaNumPro（多个 GA block），loop1SrcStride = gSize*aSize（block 间 stride），
//   loop1DstStride = (gSize+1)*aSizeAligned（UB 中含 padding 的 stride）。
//   blockCount = gSize（每 GA block 内 gatherDimSize 行），dstStride 处理 aSizeAligned-aSize padding。
// ============================================================================
template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::CopyInX(LocalTensor<int8_t>& xLocal, int32_t gaCoreOffset,
                                                                int32_t gaNumPro)
{
    LoopModeParams loopModeParamsT1;
    loopModeParamsT1.loop1Size = gaNumPro;
    loopModeParamsT1.loop2Size = 1;
    loopModeParamsT1.loop1SrcStride = tilingData_->gSize * tilingData_->aSize;
    loopModeParamsT1.loop2SrcStride = 0;
    loopModeParamsT1.loop1DstStride = (tilingData_->gSize + 1) * tilingData_->aSizeAligned;
    loopModeParamsT1.loop2DstStride = 0;

    SetLoopModePara(loopModeParamsT1, DataCopyMVType::OUT_TO_UB);

    DataCopyPadExtParams<int8_t> dataCopyPadExtParams;
    dataCopyPadExtParams.isPad = false;
    dataCopyPadExtParams.leftPadding = 0;
    dataCopyPadExtParams.rightPadding = 0;
    dataCopyPadExtParams.paddingValue = 0;

    DataCopyExtParams dataCoptExtParams;
    dataCoptExtParams.blockCount = tilingData_->gSize;
    dataCoptExtParams.blockLen = tilingData_->aSize;
    dataCoptExtParams.srcStride = 0;
    dataCoptExtParams.dstStride = (tilingData_->aSizeAligned - tilingData_->aSize) / Ops::Base::GetUbBlockSize();

    DataCopyPad(xLocal[tilingData_->aSizeAligned],
                xGm_[(xGmOffset_ + gaCoreOffset) * tilingData_->gSize * tilingData_->aSize], dataCoptExtParams,
                dataCopyPadExtParams);
    ResetLoopModePara(DataCopyMVType::OUT_TO_UB);
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::CopyOutY(int32_t nBurst, int32_t indicesCoreOffset,
                                                                 int32_t pCoreOffset, int32_t gaNumPro)
{
    LoopModeParams loopModeParamsT1;
    loopModeParamsT1.loop1Size = gaNumPro;
    loopModeParamsT1.loop2Size = 1;
    loopModeParamsT1.loop1SrcStride = nBurst * tilingData_->aSizeAligned;
    loopModeParamsT1.loop2SrcStride = 0;
    loopModeParamsT1.loop1DstStride = tilingData_->indicesSize * tilingData_->aSize;
    loopModeParamsT1.loop2DstStride = 0;

    SetLoopModePara(loopModeParamsT1, DataCopyMVType::UB_TO_OUT);
    DataCopyExtParams dataCoptExtParams;
    dataCoptExtParams.blockCount = nBurst;
    dataCoptExtParams.blockLen = tilingData_->aSize;
    dataCoptExtParams.srcStride = (tilingData_->aSizeAligned - tilingData_->aSize) / Ops::Base::GetUbBlockSize();
    dataCoptExtParams.dstStride = 0;

    LocalTensor<int8_t> yLocal = yQueue_.DeQue<int8_t>();
    DataCopyPad(yGm_[((xGmOffset_ + pCoreOffset) * tilingData_->indicesSize + indicesGmOffset_ + indicesCoreOffset) *
                     tilingData_->aSize],
                yLocal, dataCoptExtParams);
    ResetLoopModePara(DataCopyMVType::UB_TO_OUT);
    yQueue_.FreeTensor(yLocal);
}

template <typename INDICES_T, const bool NIS>
__aicore__ inline void GatherGaAllLoad<INDICES_T, NIS>::Process()
{
    if (blockIdx_ >= tilingData_->usedCoreNum) {
        return;
    }

    int32_t indicesBufEleNum = tilingData_->indicesBufferSize / sizeof(INDICES_T);
    int32_t indicesLoopCount = (curCoreIndicesNum_ + indicesBufEleNum - 1) / indicesBufEleNum;

    int32_t xBufGaNum = tilingData_->xBufferSize / (tilingData_->aSizeAligned * (tilingData_->gSize + 1));
    int32_t xLoopCount = (curCoreGaNum_ + xBufGaNum - 1) / xBufGaNum;

    // 避免选择 gatherVF 但是 indices 下取整后为零情况
    int32_t indicesNumToDealWithGa = tilingData_->yBufferSize / (tilingData_->aSizeAligned * xBufGaNum);
    uint16_t vRegBlockNum = Ops::Base::GetVRegSize() / Ops::Base::GetUbBlockSize();
    indicesNumToDealWithGa = indicesNumToDealWithGa / vRegBlockNum * vRegBlockNum;

    // enableGather_: xBufGaNum × aSizeAligned ≤ 512 时启用 Gather 快路径
    if (xBufGaNum * tilingData_->aSizeAligned <= GATHER_ENABLE_SIZE && indicesNumToDealWithGa != 0) {
        enableGather_ = true;
        GenIndexBuf();
    } else {
        enableGather_ = false;
    }

    InitializationX(xBufGaNum);
    for (int32_t x = 0; x < xLoopCount; x++) {
        int32_t gaNumPro = x == (xLoopCount - 1) ? curCoreGaNum_ - (xLoopCount - 1) * xBufGaNum : xBufGaNum;
        int32_t gaCoreOffset = x * xBufGaNum;
        xProcess(gaCoreOffset, gaNumPro);

        for (int32_t i = 0; i < indicesLoopCount; i++) {
            int32_t indicesNumPro = i == (indicesLoopCount - 1) ?
                                        curCoreIndicesNum_ - (indicesLoopCount - 1) * indicesBufEleNum :
                                        indicesBufEleNum;
            int32_t indicesNumOffset = i * indicesBufEleNum;
            IndicesProcess(indicesNumPro, indicesNumOffset);

            yProcess(indicesNumPro, indicesNumOffset, gaNumPro, gaCoreOffset);
        }
    }
}
