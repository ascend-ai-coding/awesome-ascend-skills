// Device regression for the migrated load/store helpers and rotary VF skeleton.
#include "kernel_operator.h"
#if defined(__NPU_DEVICE__)
#include "../references/common/arch35/regbase/code/paired_segment_rotate_vf.h"
#endif
#include <acl/acl.h>
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <vector>

using namespace AscendC;

template <typename T>
__global__ __aicore__ __vector__ void PairedRotateCheck(
    GM_ADDR input, GM_ADDR cosine, GM_ADDR sine, GM_ADDR output, uint32_t dim, uint32_t rows)
{
#if defined(__NPU_DEVICE__)
    const uint32_t halfDim = dim / 2;
    const uint32_t alignedHalf = (halfDim + 32 / sizeof(T) - 1) / (32 / sizeof(T)) * (32 / sizeof(T));
    const uint32_t stride = 2 * alignedHalf;
    const uint32_t bytes = (rows * stride + 256 / sizeof(T)) * sizeof(T);
    TPipe pipe;
    TBuf<TPosition::VECCALC> inputBuf, cosBuf, sinBuf, outputBuf;
    pipe.InitBuffer(inputBuf, bytes);
    pipe.InitBuffer(cosBuf, bytes);
    pipe.InitBuffer(sinBuf, bytes);
    pipe.InitBuffer(outputBuf, bytes);
    auto localInput = inputBuf.Get<T>();
    auto localCos = cosBuf.Get<T>();
    auto localSin = sinBuf.Get<T>();
    auto localOutput = outputBuf.Get<T>();
    GlobalTensor<T> globalInput, globalCos, globalSin, globalOutput;
    globalInput.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(input));
    globalCos.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(cosine));
    globalSin.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(sine));
    globalOutput.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(output));
    DataCopyPadExtParams<T> pad{false, 0, 0, 0};
    CopyInHalfMode<T>(localInput, globalInput, 0, rows, halfDim * sizeof(T), pad, dim, dim, 2);
    CopyInHalfMode<T>(localCos, globalCos, 0, rows, halfDim * sizeof(T), pad, dim, dim, 2);
    CopyInHalfMode<T>(localSin, globalSin, 0, rows, halfDim * sizeof(T), pad, dim, dim, 2);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    HalfAlignVF<T>(localSin, localCos, localInput, localOutput, dim, stride, rows, 1);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    CopyOutHalfMode<T>(localOutput, globalOutput, 0, rows, halfDim * sizeof(T), dim, dim, 2);
    PipeBarrier<PIPE_ALL>();
#endif
}

static uint16_t Encode(float value, bool bf16)
{
    uint32_t bits;
    std::memcpy(&bits, &value, sizeof(bits));
    if (bf16) return static_cast<uint16_t>(bits >> 16);
    if (value == 0) return 0;
    return static_cast<uint16_t>(((bits >> 16) & 0x8000) |
        ((((bits >> 23) & 255) - 112) << 10) | ((bits >> 13) & 1023));
}

static float Decode(uint16_t value, bool bf16)
{
    if (bf16) {
        uint32_t bits = static_cast<uint32_t>(value) << 16;
        float result;
        std::memcpy(&result, &bits, sizeof(result));
        return result;
    }
    if ((value & 0x7fff) == 0) return 0;
    return std::ldexp(float(1024 + (value & 1023)) / 1024, ((value >> 10) & 31) - 15) *
        ((value & 0x8000) ? -1 : 1);
}

#define CHECK_ACL(call) do { const auto error = (call); if (error != ACL_SUCCESS) { \
    std::cerr << #call << " failed: " << error << '\n'; return 1; } } while (0)

static int RunCase(uint32_t dim, uint32_t rows, unsigned dtype, aclrtStream stream)
{
    const size_t count = dim * rows;
    const size_t bytes = count * (dtype == 0 ? sizeof(float) : sizeof(uint16_t));
    std::vector<float> input(count), cosine(count), sine(count), expected(count), result(count);
    for (size_t i = 0; i < count; ++i) {
        input[i] = (int(i % 9) - 4) * 0.25f;
        cosine[i] = (int(i % 7) - 3) * 0.125f;
        sine[i] = (int(i % 5) - 2) * 0.125f;
    }
    for (uint32_t row = 0; row < rows; ++row) for (uint32_t i = 0; i < dim; ++i) {
        const size_t at = row * dim + i;
        const size_t paired = row * dim + (i + dim / 2) % dim;
        expected[at] = cosine[at] * input[at] + (i < dim / 2 ? -1 : 1) * sine[at] * input[paired];
    }
    void *deviceInput{}, *deviceCos{}, *deviceSin{}, *deviceOutput{};
    CHECK_ACL(aclrtMalloc(&deviceInput, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&deviceCos, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&deviceSin, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(&deviceOutput, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<uint16_t> packed(count);
    auto upload = [&](void* dst, const std::vector<float>& values) {
        if (dtype == 0) return aclrtMemcpy(dst, bytes, values.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
        std::transform(values.begin(), values.end(), packed.begin(),
            [=](float value) { return Encode(value, dtype == 2); });
        return aclrtMemcpy(dst, bytes, packed.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    };
    CHECK_ACL(upload(deviceInput, input));
    CHECK_ACL(upload(deviceCos, cosine));
    CHECK_ACL(upload(deviceSin, sine));
    if (dtype == 0) PairedRotateCheck<float><<<1, nullptr, stream>>>(
        static_cast<uint8_t*>(deviceInput), static_cast<uint8_t*>(deviceCos), static_cast<uint8_t*>(deviceSin), static_cast<uint8_t*>(deviceOutput), dim, rows);
    if (dtype == 1) PairedRotateCheck<half><<<1, nullptr, stream>>>(
        static_cast<uint8_t*>(deviceInput), static_cast<uint8_t*>(deviceCos), static_cast<uint8_t*>(deviceSin), static_cast<uint8_t*>(deviceOutput), dim, rows);
    if (dtype == 2) PairedRotateCheck<bfloat16_t><<<1, nullptr, stream>>>(
        static_cast<uint8_t*>(deviceInput), static_cast<uint8_t*>(deviceCos), static_cast<uint8_t*>(deviceSin), static_cast<uint8_t*>(deviceOutput), dim, rows);
    CHECK_ACL(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    if (dtype == 0) {
        CHECK_ACL(aclrtMemcpy(result.data(), bytes, deviceOutput, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    } else {
        CHECK_ACL(aclrtMemcpy(packed.data(), bytes, deviceOutput, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
        std::transform(packed.begin(), packed.end(), result.begin(),
            [=](uint16_t value) { return Decode(value, dtype == 2); });
    }
    for (size_t i = 0; i < count; ++i) if (result[i] != expected[i]) {
        std::cerr << "dim=" << dim << " rows=" << rows << " dtype=" << dtype << " index=" << i
                  << " actual=" << result[i] << " expected=" << expected[i] << '\n';
        return 2;
    }
    CHECK_ACL(aclrtFree(deviceInput));
    CHECK_ACL(aclrtFree(deviceCos));
    CHECK_ACL(aclrtFree(deviceSin));
    CHECK_ACL(aclrtFree(deviceOutput));
    return 0;
}

int main()
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream{};
    CHECK_ACL(aclrtCreateStream(&stream));
    for (uint32_t dim : {2, 16, 126, 128, 130, 256}) for (uint32_t rows : {1, 3})
        for (unsigned dtype = 0; dtype < 3; ++dtype) {
            if (const int status = RunCase(dim, rows, dtype, stream)) return status;
        }
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    std::cout << "PASS 36 device cases: FP32/FP16/BF16, aligned/tail dimensions, CPU reference exact\n";
}
