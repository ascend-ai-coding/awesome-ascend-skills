#include "kernel_operator.h"
#ifdef __NPU_DEVICE__
#include "cum_oneway_sklansky.h"
#endif
using namespace AscendC;
template <class T>
__global__ __aicore__ __vector__ void SklanskyProbe(GM_ADDR x, GM_ADDR y, int32_t r, int32_t w)
{
#ifdef __NPU_DEVICE__
    TPipe pipe;
    TBuf<TPosition::VECCALC> buf;
    pipe.InitBuffer(buf, r * w * 4);
    auto u = buf.Get<T>();
    GlobalTensor<T> gx, gy;
    gx.SetGlobalBuffer((__gm__ T*)x);
    gy.SetGlobalBuffer((__gm__ T*)y);
    DataCopy(u, gx, r * w);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    ScanOps::CumOnewaySklansky<T> op;
    op.BaseProcess(u, r, w);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(gy, u, r * w);
    PipeBarrier<PIPE_ALL>();
#endif
}

#ifdef __NPU_DEVICE__
template void SklanskyProbe<float>(GM_ADDR, GM_ADDR, int32_t, int32_t);
template void SklanskyProbe<int32_t>(GM_ADDR, GM_ADDR, int32_t, int32_t);
#endif
#ifndef __NPU_DEVICE__
#include <acl/acl.h>
#include <iostream>
#include <vector>
#define ACL(x) \
    do { \
        auto e = (x); \
        if (e) { \
            std::cerr << #x << ":" << e << "\n"; \
            return 1; \
        } \
    } while (0)
template <class T>
int test(int r, int w, aclrtStream stream)
{
    size_t count = r * w, bytes = count * 4;
    std::vector<T> x(count), y(count);
    for (size_t i = 0; i < count; i++)
        x[i] = T(int(i % 13) - 6);
    void *dx{}, *dy{};
    ACL(aclrtMalloc(&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMalloc(&dy, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMemcpy(dx, bytes, x.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL(aclrtMemset(dy, bytes, 0xa5, bytes));
    SklanskyProbe<T><<<1, nullptr, stream>>>((uint8_t*)dx, (uint8_t*)dy, r, w);
    ACL(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    ACL(aclrtMemcpy(y.data(), bytes, dy, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    for (int col = 0; col < w; col++) {
        T sum = 0;
        for (int row = 0; row < r; row++) {
            size_t i = row * w + col;
            sum += x[i];
            if (y[i] != sum) {
                std::cerr << "FAIL r=" << r << " w=" << w << " at=" << i << " got=" << y[i] << " expected=" << sum
                          << "\n";
                return 2;
            }
        }
    }
    ACL(aclrtFree(dx));
    ACL(aclrtFree(dy));
    return 0;
}
int main()
{
    ACL(aclInit(nullptr));
    ACL(aclrtSetDevice(0));
    aclrtStream stream;
    ACL(aclrtCreateStream(&stream));
    int count = 0;
    for (int r : {1, 2, 3, 7, 8, 9, 16, 17, 31, 32, 33, 64, 125})
        for (int w : {64, 128}) {
            if (test<float>(r, w, stream) || test<int32_t>(r, w, stream))
                return 2;
            count += 2;
        }
    ACL(aclrtDestroyStream(stream));
    ACL(aclrtResetDevice(0));
    ACL(aclFinalize());
    std::cout << "PASS " << count << " Sklansky FP32/INT32 cases, CPU prefix reference exact\n";
}
#endif
