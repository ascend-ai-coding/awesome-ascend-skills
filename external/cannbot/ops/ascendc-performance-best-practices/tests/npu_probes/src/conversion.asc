#include "kernel_operator.h"
#include "transpose_tiling_data.h"
#ifdef __NPU_DEVICE__
#include "transpose_small_shape.h"
#include "transpose_tensor_move.h"
#endif
using namespace AscendC;
template <class T, bool Move>
__global__ __aicore__ __vector__ void Convert(GM_ADDR x, GM_ADDR y, TransposeOpTilingData td)
{
#ifdef __NPU_DEVICE__
    if constexpr (Move) {
        TPipe p;
        Transpose::TransposeTensorMove<T> op;
        op.Init(x, y, &td, &p);
        op.Process();
    } else {
        Transpose::TransposeSmallShape<T> op;
        op.Init(x, y, &td);
        op.Process();
    }
#endif
}
#ifdef __NPU_DEVICE__
#define INST(T) \
    template void Convert<T, false>(GM_ADDR, GM_ADDR, TransposeOpTilingData); \
    template void Convert<T, true>(GM_ADDR, GM_ADDR, TransposeOpTilingData);
INST(uint8_t)
INST(int16_t) INST(int32_t) INST(int64_t) INST(float) INST(half) INST(bfloat16_t)
#undef INST
#endif
#ifndef __NPU_DEVICE__
#include <acl/acl.h>
#include <platform/platform_ascendc.h>
#include <vector>
#include <iostream>
#include <cstring>
#include <algorithm>
#define ACL(x) \
    do { \
        auto e = (x); \
        if (e) { \
            std::cerr << #x << ":" << e << "\n"; \
            return 1; \
        } \
    } while (0)
    template <class T, bool Move>
    int test(std::vector<int64_t> shape, std::vector<int64_t> perm, int cores, uint64_t ub, aclrtStream stream)
{
    TransposeOpTilingData td{};
    td.permSize = shape.size();
    size_t count = 1;
    for (size_t a = 0; a < shape.size(); a++) {
        td.inputShape[a] = shape[a];
        td.perm[a] = perm[a];
        td.outputShape[a] = shape[perm[a]];
        count *= shape[a];
    }
    cores = std::min<size_t>(cores, count);
    td.ubSize = ub;
    td.inUbFactor = (ub / 2 / sizeof(T) / 32) * 32;
    td.realCoreNum = cores;
    if (Move) {
        td.blkFactor = count / cores;
        td.blkTailFactor = count % cores;
    } else {
        td.blkFactor = (count + cores - 1) / cores;
        td.realCoreNum = (count + td.blkFactor - 1) / td.blkFactor;
        td.blkTailFactor = count - (td.realCoreNum - 1) * td.blkFactor;
    }
    size_t bytes = count * sizeof(T);
    std::vector<uint8_t> x(bytes), y(bytes + 64);
    for (size_t i = 0; i < bytes; i++)
        x[i] = uint8_t(i * 43 + 97);
    void *dx{}, *dy{};
    ACL(aclrtMalloc(&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMalloc(&dy, y.size(), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMemcpy(dx, bytes, x.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL(aclrtMemset(dy, y.size(), 0xa5, y.size()));
    Convert<T, Move><<<td.realCoreNum, nullptr, stream>>>((uint8_t*)dx, (uint8_t*)dy, td);
    ACL(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    ACL(aclrtMemcpy(y.data(), y.size(), dy, y.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    std::vector<size_t> stride(shape.size(), 1);
    for (int a = int(shape.size()) - 2; a >= 0; a--)
        stride[a] = stride[a + 1] * shape[a + 1];
    for (size_t j = 0; j < count; j++) {
        size_t src = j;
        if (!Move) {
            size_t v = j;
            src = 0;
            for (int a = int(shape.size()) - 1; a >= 0; a--) {
                src += (v % td.outputShape[a]) * stride[perm[a]];
                v /= td.outputShape[a];
            }
        }
        if (memcmp(y.data() + j * sizeof(T), x.data() + src * sizeof(T), sizeof(T))) {
            std::cerr << "FAIL conversion bytes=" << sizeof(T) << " Move=" << Move << " rank=" << shape.size()
                      << " cores=" << cores << " j=" << j << "\n";
            return 2;
        }
    }
    for (size_t i = bytes; i < y.size(); i++)
        if (y[i] != 0xa5) {
            std::cerr << "output overrun\n";
            return 3;
        }
    ACL(aclrtFree(dx));
    ACL(aclrtFree(dy));
    return 0;
}
int main()
{
    ACL(aclInit(nullptr));
    ACL(aclrtSetDevice(0));
    aclrtStream stream;
    ACL(aclrtCreateStream(&stream));
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    int cases = 0;
    for (int cores : {1, int(platform->GetCoreNumAiv())}) {
        for (int rank = 2; rank <= 8; rank++)
            for (int p = 0; p < (rank == 2 ? 1 : 2); p++) {
                std::vector<int64_t> shape(rank), perm(rank);
                for (int a = 0; a < rank; a++) {
                    shape[a] = a % 2 ? 3 : 2;
                    perm[a] = p ? (a + 1) % rank : rank - 1 - a;
                }
#define TEST(T) \
    if (test<T, false>(shape, perm, cores, ub, stream)) \
        return 2; \
    cases++;
                TEST(uint8_t) TEST(int16_t) TEST(int32_t) TEST(int64_t) TEST(float) TEST(half) TEST(bfloat16_t)
#undef TEST
            }
        for (int64_t n : {1, 3, 33, 257, 65537}) {
#define TEST(T) \
    if (test<T, true>({n}, {0}, cores, ub, stream)) \
        return 2; \
    cases++;
            TEST(uint8_t) TEST(int16_t) TEST(int32_t) TEST(int64_t) TEST(float) TEST(half) TEST(bfloat16_t)
#undef TEST
        }
    }
    ACL(aclrtDestroyStream(stream));
    ACL(aclrtResetDevice(0));
    ACL(aclFinalize());
    std::cout << "PASS " << cases
              << " conversion cases: 7 types, ranks 2-8 permutations and tensor-move, CPU byte-exact reference and "
                 "output canaries\n";
}
#endif
