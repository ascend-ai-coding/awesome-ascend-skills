#include "kernel_operator.h"
#ifdef __NPU_DEVICE__
#include "register_resident_vector_chain_vf.h"
#endif
using namespace AscendC;
template <class T, bool Round>
__global__ __aicore__ __vector__ void ChainProbe(GM_ADDR a, GM_ADDR b, GM_ADDR out, uint32_t n, uint32_t padded)
{
#ifdef __NPU_DEVICE__
    TPipe pipe;
    TBuf<TPosition::VECCALC> ab, bb, ob;
    pipe.InitBuffer(ab, padded * 2);
    pipe.InitBuffer(bb, padded * 2);
    pipe.InitBuffer(ob, padded * 2);
    auto la = ab.Get<T>(), lb = bb.Get<T>(), lo = ob.Get<T>();
    GlobalTensor<T> ga, gb, go;
    ga.SetGlobalBuffer((__gm__ T*)a);
    gb.SetGlobalBuffer((__gm__ T*)b);
    go.SetGlobalBuffer((__gm__ T*)out);
    DataCopy(la, ga, padded);
    DataCopy(lb, gb, padded);
    Duplicate(lo.template ReinterpretCast<uint16_t>(), IsSameType<T, half>::value ? uint16_t(0x3c00) : uint16_t(0x3f80),
              padded);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    VectorChainVF<T, Round>((__ubuf__ T*)la.GetPhyAddr(), (__ubuf__ T*)lb.GetPhyAddr(), (__ubuf__ T*)lo.GetPhyAddr(), n,
                            -0.5f, 2.f, -2.f, -0.25f, 4.f, -4.f);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(go, lo, padded);
    PipeBarrier<PIPE_ALL>();
#endif
}

#ifdef __NPU_DEVICE__
template void ChainProbe<half, false>(GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t);
template void ChainProbe<half, true>(GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t);
template void ChainProbe<bfloat16_t, false>(GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t);
template void ChainProbe<bfloat16_t, true>(GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t);
#endif
#ifndef __NPU_DEVICE__
#include <acl/acl.h>
#include <cmath>
#include <cstring>
#include <iostream>
#include <vector>
#include <algorithm>
#define ACL(x) \
    do { \
        auto e = (x); \
        if (e) { \
            std::cerr << #x << ":" << e << "\n"; \
            return 1; \
        } \
    } while (0)
uint16_t encode(float f, bool bf)
{
    uint32_t u;
    memcpy(&u, &f, 4);
    if (bf)
        return uint16_t((u + 0x7fff + ((u >> 16) & 1)) >> 16);
    uint32_t sign = (u >> 16) & 0x8000, exp = (u >> 23) & 255, mant = u & 0x7fffff;
    if (exp == 255)
        return sign | 0x7c00 | (mant ? 0x200 : 0);
    if (exp > 142)
        return sign | 0x7c00;
    if (exp < 102)
        return sign;
    if (exp < 113) {
        mant |= 0x800000;
        unsigned shift = 126 - exp;
        uint32_t q = mant >> shift, rem = mant & ((1u << shift) - 1), mid = 1u << (shift - 1);
        return sign | uint16_t(q + (rem > mid || (rem == mid && (q & 1))));
    }
    uint32_t base = ((exp - 112) << 10) | (mant >> 13), rem = mant & 8191;
    return sign | uint16_t(base + (rem > 4096 || (rem == 4096 && (base & 1))));
}
float decode(uint16_t u, bool bf)
{
    if (bf) {
        uint32_t bits = uint32_t(u) << 16;
        float f;
        memcpy(&f, &bits, 4);
        return f;
    }
    unsigned e = (u >> 10) & 31, m = u & 1023;
    return std::ldexp(e ? float(1024 + m) : float(m), e ? int(e) - 25 : -24) * (u & 0x8000 ? -1 : 1);
}
int main()
{
    ACL(aclInit(nullptr));
    ACL(aclrtSetDevice(0));
    aclrtStream stream;
    ACL(aclrtCreateStream(&stream));
    int cases = 0;
    double maxerr[2] = {};
    for (bool bf : {false, true})
        for (bool round : {false, true})
            for (int pattern = 0; pattern < 3; pattern++)
                for (uint32_t n : {1, 3, 63, 64, 65, 127, 128, 129, 1003}) {
                    uint32_t padded = ((n + 63) / 64 + 2) * 64;
                    size_t bytes = padded * 2;
                    std::vector<uint16_t> a(padded), b(padded), out(padded);
                    std::vector<float> ref(n);
                    for (uint32_t i = 0; i < n; i++) {
                        float av = (int((i * 17 + pattern * 7) % 257) - 128) / 16.f,
                              bv = (int((i * 11 + pattern * 13) % 193) - 96) / 16.f;
                        a[i] = encode(av, bf);
                        b[i] = encode(bv, bf);
                        av = decode(a[i], bf);
                        bv = decode(b[i], bf);
                        float x = 2.f / (1.f + std::exp(-0.5f * av)) * 2.f - 2.f,
                              y = 4.f / (1.f + std::exp(-0.25f * bv)) * 2.f - 4.f;
                        if (round) {
                            x = decode(encode(x, bf), bf);
                            y = decode(encode(y, bf), bf);
                        }
                        ref[i] = decode(encode(x * y, bf), bf);
                    }
                    void *da{}, *db{}, *dy{};
                    ACL(aclrtMalloc(&da, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
                    ACL(aclrtMalloc(&db, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
                    ACL(aclrtMalloc(&dy, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
                    ACL(aclrtMemcpy(da, bytes, a.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
                    ACL(aclrtMemcpy(db, bytes, b.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
                    ACL(aclrtMemset(dy, bytes, 0xa5, bytes));
                    if (bf) {
                        if (round)
                            ChainProbe<bfloat16_t, true>
                                <<<1, nullptr, stream>>>((uint8_t*)da, (uint8_t*)db, (uint8_t*)dy, n, padded);
                        else
                            ChainProbe<bfloat16_t, false>
                                <<<1, nullptr, stream>>>((uint8_t*)da, (uint8_t*)db, (uint8_t*)dy, n, padded);
                    } else {
                        if (round)
                            ChainProbe<half, true>
                                <<<1, nullptr, stream>>>((uint8_t*)da, (uint8_t*)db, (uint8_t*)dy, n, padded);
                        else
                            ChainProbe<half, false>
                                <<<1, nullptr, stream>>>((uint8_t*)da, (uint8_t*)db, (uint8_t*)dy, n, padded);
                    }
                    ACL(aclrtSynchronizeStreamWithTimeout(stream, 10000));
                    ACL(aclrtMemcpy(out.data(), bytes, dy, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
                    for (uint32_t i = 0; i < padded; i++) {
                        float got = decode(out[i], bf);
                        if (i >= n) {
                            if (out[i] != (bf ? 0x3f80 : 0x3c00)) {
                                std::cerr << "tail overwritten " << i << "\n";
                                return 3;
                            }
                            continue;
                        }
                        double err = std::abs(double(got) - ref[i]);
                        maxerr[bf] = std::max(maxerr[bf], err);
                        double tol = (bf ? 0.016 : 0.002) * std::abs(ref[i]) + (bf ? 0.0002 : 0.00002);
                        if (!std::isfinite(got) || err > tol) {
                            std::cerr << "FAIL bf=" << bf << " round=" << round << " n=" << n << " i=" << i
                                      << " got=" << got << " ref=" << ref[i] << " err=" << err << "\n";
                            return 2;
                        }
                    }
                    ACL(aclrtFree(da));
                    ACL(aclrtFree(db));
                    ACL(aclrtFree(dy));
                    cases++;
                }
    ACL(aclrtDestroyStream(stream));
    ACL(aclrtResetDevice(0));
    ACL(aclFinalize());
    std::cout << "PASS " << cases
              << " chain cases: FP16/BF16, round/no-round, CPU reference and tail canaries; max abs error=" << maxerr[0]
              << "," << maxerr[1] << "\n";
}
#endif
