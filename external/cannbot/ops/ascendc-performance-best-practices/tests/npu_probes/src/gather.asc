#include "kernel_operator.h"
#include "gather_tiling_data.h"
#ifdef __NPU_DEVICE__
#include "gather_ga_all_load.h"
#include "gather_simd_last_gather.h"
#endif
using namespace AscendC;
template <class I, bool Neg>
__global__ __aicore__ __vector__ void GatherGA(GM_ADDR x, GM_ADDR indices, GM_ADDR y, GatherGaAllLoadTilingData td)
{
#ifdef __NPU_DEVICE__
    TPipe p;
    gatherv2::GatherGaAllLoad<I, Neg> op(&p);
    op.Init(x, indices, y, &td);
    op.Process();
#endif
}
template <class I, bool Neg>
__global__ __aicore__ __vector__ void GatherLast(GM_ADDR x, GM_ADDR indices, GM_ADDR y, GatherLastTilingData td)
{
#ifdef __NPU_DEVICE__
    TPipe p;
    gatherv2::GatherSimdLastGather<int32_t, I, Neg> op(&p);
    op.Init(x, indices, y, &td);
    op.Process();
#endif
}
#ifdef __NPU_DEVICE__
#define INST(I, N) \
    template void GatherGA<I, N>(GM_ADDR, GM_ADDR, GM_ADDR, GatherGaAllLoadTilingData); \
    template void GatherLast<I, N>(GM_ADDR, GM_ADDR, GM_ADDR, GatherLastTilingData);
INST(int32_t, false)
INST(int32_t, true) INST(int64_t, false) INST(int64_t, true)
#undef INST
#endif
#ifndef __NPU_DEVICE__
#include "gather_tiling.h"
#include <acl/acl.h>
#include <platform/platform_ascendc.h>
#include <vector>
#include <iostream>
#include <cstring>
#define ACL(x) \
    do { \
        auto e = (x); \
        if (e) { \
            std::cerr << #x << ":" << e << "\n"; \
            return 1; \
        } \
    } while (0)
    template <class I, bool Neg>
    int test(bool ga, int64_t o, int64_t g, int64_t n, aclrtStream stream, gatherv2::GatherTilingParams p, bool invalid)
{
    int64_t d = ga ? 8 : 17;
    gatherv2::GatherTilingContext ctx{};
    ctx.params = p;
    ctx.shape = {1, o, d, g, n, 4, int(sizeof(I)), Neg, 0};
    if (ga)
        gatherv2::GaAllLoadTiling(ctx);
    else
        gatherv2::LastGatherTiling(ctx);
    size_t count = o * d * n, outcount = o * g * n;
    std::vector<int32_t> x(count), y(outcount + 16);
    std::vector<I> indices(g);
    for (size_t i = 0; i < count; i++)
        x[i] = int(i * 37) % 100003 - 50001;
    for (int64_t j = 0; j < g; j++)
        indices[j] = I((j * 7) % d - (Neg && j % 2 ? d : 0));
    if (invalid)
        for (int64_t j = 0; j < g; j++) {
            if (j % 11 == 0)
                indices[j] = I(999);
            if (j % 13 == 0)
                indices[j] = I(-999);
            if constexpr (sizeof(I) == 8) {
                if (j % 17 == 0)
                    indices[j] = (int64_t(1) << 32) + 3;
                if (j % 19 == 0)
                    indices[j] = -(int64_t(1) << 32) + 5;
            }
        }
    void *dx{}, *di{}, *dy{};
    ACL(aclrtMalloc(&dx, count * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMalloc(&di, g * sizeof(I), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMalloc(&dy, y.size() * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMemcpy(dx, count * 4, x.data(), count * 4, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL(aclrtMemcpy(di, g * sizeof(I), indices.data(), g * sizeof(I), ACL_MEMCPY_HOST_TO_DEVICE));
    ACL(aclrtMemset(dy, y.size() * 4, 0xa5, y.size() * 4));
    if (ga)
        GatherGA<I, Neg><<<ctx.needCoreNum, nullptr, stream>>>((uint8_t*)dx, (uint8_t*)di, (uint8_t*)dy,
                                                               ctx.result.gaAllLoadTilingData);
    else
        GatherLast<I, Neg><<<ctx.needCoreNum, nullptr, stream>>>((uint8_t*)dx, (uint8_t*)di, (uint8_t*)dy,
                                                                 ctx.result.lastGatherTilingData);
    ACL(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    ACL(aclrtMemcpy(y.data(), y.size() * 4, dy, y.size() * 4, ACL_MEMCPY_DEVICE_TO_HOST));
    for (int64_t row = 0; row < o; row++)
        for (int64_t j = 0; j < g; j++)
            for (int64_t col = 0; col < n; col++) {
                int64_t index = indices[j];
                if (Neg && index < 0 && index >= -d)
                    index += d;
                bool oob = index < 0 || index >= d;
                if (oob)
                    index = 0;
                size_t at = (row * g + j) * n + col;
                auto expected = ga && oob ? 0 : x[(row * d + index) * n + col];
                if (y[at] != expected) {
                    std::cerr << "FAIL ga=" << ga << " o=" << o << " g=" << g << " n=" << n
                              << " indexbytes=" << sizeof(I) << " neg=" << Neg << " at=" << at << " got=" << y[at]
                              << " ref=" << expected << "\n";
                    return 2;
                }
            }
    for (size_t i = outcount; i < y.size(); i++)
        if (uint32_t(y[i]) != 0xa5a5a5a5U) {
            std::cerr << "output overrun\n";
            return 3;
        }
    ACL(aclrtFree(dx));
    ACL(aclrtFree(di));
    ACL(aclrtFree(dy));
    return 0;
}
int main()
{
    ACL(aclInit(nullptr));
    ACL(aclrtSetDevice(0));
    aclrtStream stream;
    ACL(aclrtCreateStream(&stream));
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    gatherv2::GatherTilingParams p{int64_t(ub), platform->GetCoreNumAiv(), 32, 256};
    int count = 0;
    for (bool invalid : {false, true})
        for (bool ga : {false, true})
            for (int64_t o : {1, 3, 67})
                for (int64_t g : {33, 129})
                    for (int64_t n : (ga ? std::vector<int64_t>{65, 128} : std::vector<int64_t>{1})) {
                        if (test<int32_t, false>(ga, o, g, n, stream, p, invalid) ||
                            test<int32_t, true>(ga, o, g, n, stream, p, invalid) ||
                            test<int64_t, false>(ga, o, g, n, stream, p, invalid) ||
                            test<int64_t, true>(ga, o, g, n, stream, p, invalid))
                            return 2;
                        count += 4;
                    }
    ACL(aclrtDestroyStream(stream));
    ACL(aclrtResetDevice(0));
    ACL(aclFinalize());
    std::cout << "PASS " << count
              << " Gather cases: last-axis/GA, I32/I64 indices, negative indices, CPU byte-exact reference and output "
                 "canaries\n";
}
#endif
