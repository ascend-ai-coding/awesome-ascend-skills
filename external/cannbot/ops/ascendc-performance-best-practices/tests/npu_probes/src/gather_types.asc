#include "kernel_operator.h"
#include "gather_tiling_data.h"
#ifdef __NPU_DEVICE__
#include "gather_simd_last_gather.h"
#endif
using namespace AscendC;
template <class X, class I, bool Neg>
__global__ __aicore__ __vector__ void GatherTypes(GM_ADDR x, GM_ADDR indices, GM_ADDR y, GatherLastTilingData td)
{
#ifdef __NPU_DEVICE__
    TPipe p;
    gatherv2::GatherSimdLastGather<X, I, Neg> op(&p);
    op.Init(x, indices, y, &td);
    op.Process();
#endif
}
#define EACH_INDEX(M, X) M(X, int8_t) M(X, int16_t) M(X, int32_t) M(X, int64_t)
#define EACH_TYPE(M) \
    EACH_INDEX(M, float) \
    EACH_INDEX(M, half) EACH_INDEX(M, bfloat16_t) EACH_INDEX(M, int8_t) EACH_INDEX(M, int16_t) EACH_INDEX(M, int32_t)
#ifdef __NPU_DEVICE__
#define INST(X, I) \
    template void GatherTypes<X, I, false>(GM_ADDR, GM_ADDR, GM_ADDR, GatherLastTilingData); \
    template void GatherTypes<X, I, true>(GM_ADDR, GM_ADDR, GM_ADDR, GatherLastTilingData);
EACH_TYPE(INST)
#undef INST
#endif
#ifndef __NPU_DEVICE__
#include "gather_tiling.h"
#include <acl/acl.h>
#include <platform/platform_ascendc.h>
#include <vector>
#include <iostream>
#include <cstring>
#include <limits>
#define ACL(x) \
    do { \
        auto e = (x); \
        if (e) { \
            std::cerr << #x << ":" << e << "\n"; \
            return 1; \
        } \
    } while (0)
template <class X, class I, bool Neg>
int test(int64_t o, int64_t g, aclrtStream stream, gatherv2::GatherTilingParams p)
{
    int64_t d = 17;
    gatherv2::GatherTilingContext ctx{};
    ctx.params = p;
    ctx.shape = {1, o, d, g, 1, int(sizeof(X)), int(sizeof(I)), Neg, 0};
    gatherv2::LastGatherTiling(ctx);
    size_t bytes = o * d * sizeof(X), outbytes = o * g * sizeof(X);
    std::vector<uint8_t> x(bytes), y(outbytes + 64);
    std::vector<I> indices(g);
    for (size_t i = 0; i < bytes; i++)
        x[i] = uint8_t(i * 37 + 193);
    for (int64_t j = 0; j < g; j++) {
        indices[j] = I((j * 7) % d - (Neg && j % 2 ? d : 0));
        if (j % 11 == 0)
            indices[j] = std::numeric_limits<I>::max();
        if (j % 13 == 0)
            indices[j] = std::numeric_limits<I>::min();
        if constexpr (sizeof(I) == 8) {
            if (j % 17 == 0)
                indices[j] = (int64_t(1) << 32) + 3;
            if (j % 19 == 0)
                indices[j] = -(int64_t(1) << 32) + 5;
        }
    }
    void *dx{}, *di{}, *dy{};
    ACL(aclrtMalloc(&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMalloc(&di, g * sizeof(I), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMalloc(&dy, y.size(), ACL_MEM_MALLOC_HUGE_FIRST));
    ACL(aclrtMemcpy(dx, bytes, x.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL(aclrtMemcpy(di, g * sizeof(I), indices.data(), g * sizeof(I), ACL_MEMCPY_HOST_TO_DEVICE));
    ACL(aclrtMemset(dy, y.size(), 0xa5, y.size()));
    GatherTypes<X, I, Neg><<<ctx.needCoreNum, nullptr, stream>>>((uint8_t*)dx, (uint8_t*)di, (uint8_t*)dy,
                                                                 ctx.result.lastGatherTilingData);
    ACL(aclrtSynchronizeStreamWithTimeout(stream, 10000));
    ACL(aclrtMemcpy(y.data(), y.size(), dy, y.size(), ACL_MEMCPY_DEVICE_TO_HOST));
    for (int64_t row = 0; row < o; row++)
        for (int64_t j = 0; j < g; j++) {
            int64_t index = indices[j];
            if (Neg && index < 0 && index >= -d)
                index += d;
            if (index < 0 || index >= d)
                index = 0;
            size_t at = (row * g + j) * sizeof(X), expected = (row * d + index) * sizeof(X);
            if (memcmp(y.data() + at, x.data() + expected, sizeof(X))) {
                std::cerr << "FAIL Xbytes=" << sizeof(X) << " Ibytes=" << sizeof(I) << " neg=" << Neg << " o=" << o
                          << " g=" << g << " at=" << at << " idx=" << int64_t(indices[j]) << "\n";
                return 2;
            }
        }
    for (size_t i = outbytes; i < y.size(); i++)
        if (y[i] != 0xa5) {
            std::cerr << "output overrun\n";
            return 3;
        }
    ACL(aclrtFree(dx));
    ACL(aclrtFree(di));
    ACL(aclrtFree(dy));
    return 0;
}
int main()
{
    ACL(aclInit(nullptr));
    ACL(aclrtSetDevice(0));
    aclrtStream stream;
    ACL(aclrtCreateStream(&stream));
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    gatherv2::GatherTilingParams p{int64_t(ub), platform->GetCoreNumAiv(), 32, 256};
    int count = 0;
    for (int64_t o : {1, 3, 137})
        for (int64_t g : {33, 129, 4097}) {
#define TEST(X, I) \
    if (test<X, I, false>(o, g, stream, p) || test<X, I, true>(o, g, stream, p)) \
        return 2; \
    count += 2;
            EACH_TYPE(TEST)
#undef TEST
        }
    ACL(aclrtDestroyStream(stream));
    ACL(aclrtResetDevice(0));
    ACL(aclFinalize());
    std::cout << "PASS " << count
              << " last-axis Gather cases: 6 payload types x 4 index types, negatives, I64 extremes, row/column "
                 "partition tails, CPU byte-exact reference and output canaries\n";
}
#endif
