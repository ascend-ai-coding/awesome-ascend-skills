#include "kernel_operator.h"
#include "scan_tiling_data.h"
#ifdef __NPU_DEVICE__
#include "cum_streaming_scan.h"
#endif
__global__ __aicore__ __vector__ void ScanCheck(GM_ADDR x,GM_ADDR values,GM_ADDR indices,ScanTilingData td) {
#ifdef __NPU_DEVICE__
 AscendC::TPipe pipe;ScanOps::CumStreamingScan<float,float> op;op.Init(x,values,indices,&td,&pipe);op.Process();
#endif
}
#ifndef __NPU_DEVICE__
#include "scan_tiling.h"
#include <acl/acl.h>
#include <platform/platform_ascendc.h>
#include <vector>
#include <iostream>
#include <limits>
#define CHECK(call) do {auto rc=(call);if(rc){std::cerr<<#call<<" failed "<<rc<<'\n';return 1;}}while(0)
int main(){
 CHECK(aclInit(nullptr));CHECK(aclrtSetDevice(0));aclrtStream stream;CHECK(aclrtCreateStream(&stream));
 auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)return 1;
 scan_tiling::PlatformParam p{};p.numBlocks=platform->GetCoreNumAiv();if(!p.numBlocks)return 1;
 for(int64_t n:{1,5,64,129}) {
  scan_tiling::CaseShape s{3,9,n,0};ScanTilingData td{};auto blocks=scan_tiling::TilingScan(s,p,td);
  size_t count=s.m*s.r*s.n,bytes=count*sizeof(float);std::vector<float>x(count),values(count);std::vector<int32_t>indices(count);
  for(size_t i=0;i<count;++i)x[i]=float(int(i%7)-3)*0.25f;
  void *dx{},*dv{},*di{};CHECK(aclrtMalloc(&dx,bytes,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&dv,bytes,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&di,bytes,ACL_MEM_MALLOC_HUGE_FIRST));
  CHECK(aclrtMemcpy(dx,bytes,x.data(),bytes,ACL_MEMCPY_HOST_TO_DEVICE));CHECK(aclrtMemset(dv,bytes,0xa5,bytes));CHECK(aclrtMemset(di,bytes,0xa5,bytes));
  ScanCheck<<<blocks,nullptr,stream>>>(static_cast<uint8_t*>(dx),static_cast<uint8_t*>(dv),static_cast<uint8_t*>(di),td);
  CHECK(aclrtSynchronizeStreamWithTimeout(stream,10000));CHECK(aclrtMemcpy(values.data(),bytes,dv,bytes,ACL_MEMCPY_DEVICE_TO_HOST));CHECK(aclrtMemcpy(indices.data(),bytes,di,bytes,ACL_MEMCPY_DEVICE_TO_HOST));
  for(int64_t m=0;m<s.m;++m)for(int64_t col=0;col<n;++col){float best=std::numeric_limits<float>::infinity();int32_t index=0;
   for(int32_t r=0;r<s.r;++r){size_t at=(m*s.r+r)*n+col;if(x[at]<=best){best=x[at];index=r;}
    if(values[at]!=best||indices[at]!=index){std::cerr<<"FAIL N="<<n<<" at="<<at<<" value="<<values[at]<<" expected="<<best<<" index="<<indices[at]<<" expected="<<index<<'\n';return 2;}
   }
  }
  CHECK(aclrtFree(dx));CHECK(aclrtFree(dv));CHECK(aclrtFree(di));
 }
 CHECK(aclrtDestroyStream(stream));CHECK(aclrtResetDevice(0));CHECK(aclFinalize());std::cout<<"PASS 4 FP32 streaming scan cases: exact CPU values and last-tie indices\n";
}
#endif
