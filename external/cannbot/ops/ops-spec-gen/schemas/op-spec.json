      "FRACTAL_ZN_RNN",
      "NYUV",
      "NYUV_A"
    ]
  },
  "$defs": {
    "official_dtype": {
      "enum": ["float32","float16","int8","int32","uint8","int16","uint16","uint32","int64","uint64","float64","bool","string","dual_sub_int8","dual_sub_uint8","complex64","complex128","qint8","qint16","qint32","quint8","quint16","resource","string_ref","dual","variant","bfloat16","undefined","int4","uint1","int2","uint2","complex32","hifloat8","float8_e5m2","float8_e4m3fn","float8_e8m0","float6_e3m2","float6_e2m3","float4_e2m1","float4_e1m2","max"]
    },
    "official_format": {
      "enum": ["NCHW","NHWC","ND","NC1HWC0","FRACTAL_Z","NC1C0HWPAD","NHWC1C0","FSR_NCHW","FRACTAL_DECONV","C1HWNC0","FRACTAL_DECONV_TRANSPOSE","FRACTAL_DECONV_SP_STRIDE_TRANS","NC1HWC0_C04","FRACTAL_Z_C04","CHWN","FRACTAL_DECONV_SP_STRIDE8_TRANS","HWCN","NC1KHKWHWC0","BN_WEIGHT","FILTER_HWCK","HASHTABLE_LOOKUP_LOOKUPS","HASHTABLE_LOOKUP_KEYS","HASHTABLE_LOOKUP_VALUE","HASHTABLE_LOOKUP_OUTPUT","HASHTABLE_LOOKUP_HITS","C1HWNCoC0","MD","NDHWC","FRACTAL_ZZ","FRACTAL_NZ","NCDHW","DHWCN","NDC1HWC0","FRACTAL_Z_3D","CN","NC","DHWNC","FRACTAL_Z_3D_TRANSPOSE","FRACTAL_ZN_LSTM","FRACTAL_Z_G","RESERVED","ALL","NULL","ND_RNN_BIAS","FRACTAL_ZN_RNN","NYUV","NYUV_A","NCL","FRACTAL_Z_WINO","C1HWC0","FRACTAL_NZ_C0_16","FRACTAL_NZ_C0_32","FRACTAL_NZ_C0_2","FRACTAL_NZ_C0_4","FRACTAL_NZ_C0_8","END","MAX"]
    },
    "legacy_dtype": {"enum": ["float64", "float32", "float16", "bfloat16", "float8_e4m3fn", "float8_e5m2", "float8_e8m0", "hifloat8", "float4_e2m1", "float4_e1m2", "int4", "int8", "int16", "int32", "int64", "uint1", "uint4", "uint8", "uint16", "uint32", "uint64", "bool", "complex32", "complex64", "complex128"]},
    "legacy_layout": {"enum": ["ND", "NCHW", "NHWC", "NCDHW", "NDHWC", "NZ", "FRACTAL_NZ", "FRACTAL_Z", "CSR", "COO", "BSR"]},
    "supported_layouts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/layout"}},
    "complete_support": {
      "type": "object",
      "required": ["dtype_set", "unsupported_dtypes", "supported_layouts", "unsupported_layouts"],
      "properties": {
        "dtype_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/official_dtype"}},
        "unsupported_dtypes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/official_dtype"}},
        "supported_layouts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/official_format"}},
        "unsupported_layouts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/official_format"}}
      }
    },
    "unsupported_dtypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/official_dtype"},
      "description": "新契约为官方 dtype 全集减 dtype_set；无 support_universe 的旧 spec 仅记录已确认排除项。"
    },
    "unsupported_layouts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/official_format"},
      "description": "新契约为官方 format 全集减 supported_layouts；无 support_universe 的旧 spec 沿用部分排除语义。"
    },
    "list_length": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["unconstrained", "fixed", "range", "same_as", "expression"]},
        "value": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "minLength": 1}]},
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": "integer", "minimum": 0},
        "ref": {"type": "string", "pattern": "^(input|output)\\.[a-z][a-zA-Z0-9_]*$"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "unconstrained"}}}, "then": {"not": {"anyOf": [{"required": ["value"]}, {"required": ["min"]}, {"required": ["max"]}, {"required": ["ref"]}]}}},
        {"if": {"properties": {"kind": {"const": "fixed"}}}, "then": {"required": ["value"], "properties": {"value": {"type": "integer", "minimum": 0}}}},
        {"if": {"properties": {"kind": {"const": "range"}}}, "then": {"required": ["min", "max"]}},
        {"if": {"properties": {"kind": {"const": "same_as"}}}, "then": {"required": ["ref"]}},
        {"if": {"properties": {"kind": {"const": "expression"}}}, "then": {"required": ["value"], "properties": {"value": {"type": "string", "minLength": 1}}}}
      ]
    },
    "semantic_case_inputs": {
      "type": "object",
      "required": ["required", "forbidden"],
      "additionalProperties": false,
      "properties": {
        "required": {"$ref": "#/$defs/name_list"},
        "forbidden": {"$ref": "#/$defs/name_list"}
      }
    },
    "semantic_case_outputs": {
      "type": "object",
      "required": ["present", "absent"],
      "additionalProperties": false,
      "properties": {
        "present": {"$ref": "#/$defs/name_list"},
        "absent": {"$ref": "#/$defs/name_list"}
      }
    },
    "name_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$"}
    },
    "dtype": {
      "enum": ["float32","float16","int8","int32","uint8","int16","uint16","uint32","int64","uint64","float64","bool","string","dual_sub_int8","dual_sub_uint8","complex64","complex128","qint8","qint16","qint32","quint8","quint16","resource","string_ref","dual","variant","bfloat16","undefined","int4","uint1","int2","uint2","complex32","hifloat8","float8_e5m2","float8_e4m3fn","float8_e8m0","float6_e3m2","float6_e2m3","float4_e2m1","float4_e1m2","max","uint4"]
    },
    "layout": {
      "enum": ["NCHW","NHWC","ND","NC1HWC0","FRACTAL_Z","NC1C0HWPAD","NHWC1C0","FSR_NCHW","FRACTAL_DECONV","C1HWNC0","FRACTAL_DECONV_TRANSPOSE","FRACTAL_DECONV_SP_STRIDE_TRANS","NC1HWC0_C04","FRACTAL_Z_C04","CHWN","FRACTAL_DECONV_SP_STRIDE8_TRANS","HWCN","NC1KHKWHWC0","BN_WEIGHT","FILTER_HWCK","HASHTABLE_LOOKUP_LOOKUPS","HASHTABLE_LOOKUP_KEYS","HASHTABLE_LOOKUP_VALUE","HASHTABLE_LOOKUP_OUTPUT","HASHTABLE_LOOKUP_HITS","C1HWNCoC0","MD","NDHWC","FRACTAL_ZZ","FRACTAL_NZ","NCDHW","DHWCN","NDC1HWC0","FRACTAL_Z_3D","CN","NC","DHWNC","FRACTAL_Z_3D_TRANSPOSE","FRACTAL_ZN_LSTM","FRACTAL_Z_G","RESERVED","ALL","NULL","ND_RNN_BIAS","FRACTAL_ZN_RNN","NYUV","NYUV_A","NCL","FRACTAL_Z_WINO","C1HWC0","FRACTAL_NZ_C0_16","FRACTAL_NZ_C0_32","FRACTAL_NZ_C0_2","FRACTAL_NZ_C0_4","FRACTAL_NZ_C0_8","END","MAX","NZ","CSR","COO","BSR"]
    },
    "tolerance_metric": {
      "enum": ["max_relative", "max_absolute", "mean_relative", "staged_relative", "cosine_similarity", "bitwise_equal"]
    },
    "staged_fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "small_value_threshold": {"type": "number", "exclusiveMinimum": 0},
        "small_value_error": {"type": "number", "exclusiveMinimum": 0},
        "cancel_boundary": {"type": "number", "exclusiveMinimum": 0},
        "cancel_zero_threshold": {"type": "number", "exclusiveMinimum": 0},
        "error_ratio_limit": {"type": "number", "exclusiveMinimum": 0},
        "reference_mode": {"enum": ["native", "truncated", "native_or_truncated"]}
      }
    },
    "case_with_check": {
      "type": "object",
      "required": ["case", "synthesize", "machine_check"],
      "properties": {
        "case": {"type": "string"},
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "声明该 case 满足 boundary_min_cases.yaml 中的哪些 requirement.id；stage 5 用 tag 优先匹配，子串匹配作为兜底"
        },
        "synthesize": {"type": "object"},
        "machine_check": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "equals", "equals_tensor", "returns_empty",
                "produces_nan", "nan_propagates", "inf_clamps_to",
                "matches_oracle", "matches_invariant", "raises_error",
                "equals_input"
              ]
            }
          }
        }
      }
    }
  }
}
