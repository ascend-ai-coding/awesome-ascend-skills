      "DT_FLOAT4_E2M1": "float4_e2m1",
      "DT_FLOAT4_E1M2": "float4_e1m2",
      "DT_MAX": "max"
    },
    "non_tensor_dtypes": [
      "undefined",
      "max"
    ],
    "non_tensor_formats": [
