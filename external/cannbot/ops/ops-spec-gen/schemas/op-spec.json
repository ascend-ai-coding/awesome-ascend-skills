      "FRACTAL_DECONV_SP_STRIDE_TRANS",
      "NC1HWC0_C04",
      "FRACTAL_Z_C04",
      "FRACTAL_DECONV_SP_STRIDE8_TRANS",
      "NC1KHKWHWC0",
