# ============================================================
# {{op_name}} — L0 数学约束 spec
# 覆盖范式: {{paradigms_csv}}
# 由 ops/ops-spec-gen/scripts/generate_spec.py 生成；请手动填充 {{...}} 占位符
# ============================================================
schema_version: 1
{{support_universe_block}}

op:
{{op_block}}
{{paradigm_groups_block}}

inputs:
# support_universe 指定官方全集；dtype_set / supported_layouts 必须完整。
# 对应 unsupported_* 是官方全集减支持集合；旧 spec 无 support_universe 时沿用旧语义。
{{inputs_block}}

attributes:
{{attributes_block}}

outputs:
{{outputs_block}}

{{semantic_cases_block}}

{{layout_contract_block}}

{{reduction_block}}

shape_constraints:
  symbols: {{shape_symbols}}
  global_constraints:
    - "rank({{first_input}}) <= 8"
  notes: []

dtype_policy:
  promotion: {{promotion}}
  supported_combinations:
{{supported_combinations_block}}
{{accumulator_block}}

broadcast:
  kind: {{broadcast_kind}}

math_semantics:
  formula_kind: numpy_expr
  formula: |
    # TODO: 用 numpy 可 eval 的表达式描述算子语义
    {{first_output}} = {{first_input}}

  reference_oracle:
    framework: torch
    api: torch.{{op_name}}        # TODO: 替换为正确的 API 全限定名
    kwargs: {}
    available_for_dtype: [float32]
    absent: false

  invariants:
    # TODO: 至少 1 条 invariant；kind 必须在白名单（registries/invariant_kind_registry.yaml）
    []
{{composition_block}}
{{format_variants_block}}

numerical_stability:
  required: {{numerical_stability_required}}
  techniques: {{numerical_stability_techniques}}
  affects_invariants: false

numerical_tolerance:
  source: "generated initial defaults (registries/tolerance_defaults.yaml); confirm before freezing"
  per_dtype:
{{per_dtype_tolerance_block}}

boundary_conditions: []
  # 按已确认支持域及来源补齐；以下仅为候选，不是公开保证。
  # 域外且未规定行为时，不新增结果或拒绝义务。
{{default_boundary_case}}
{{extra_boundary_cases}}

extreme_inputs: []
  # 核对 dtype、值域及数值传播后补齐适用条目；不默认要求 NaN/Inf。
{{extra_extreme_cases}}

determinism:
  required: true
  accumulation_order: {{accumulation_order}}
  bitwise_reproducible: true
